{{- '/* Product Gallery Styles */' -}}
<style>
/* =============================================
   PRODUCT GALLERY — main image + thumbnails
   ============================================= */
.product-gallery {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
}

/* --- Main image container --- */
.product-gallery__main {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 4px;
  background: #f4f4f4;
  cursor: zoom-in;
}

.product-gallery__main img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  transition: opacity 0.25s ease;
}

.product-gallery__main:hover img {
  opacity: 0.92;
}

/* Zoom icon hint */
.product-gallery__zoom-hint {
  position: absolute;
  bottom: 12px;
  right: 12px;
  background: rgba(0,0,0,0.45);
  color: #fff;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.product-gallery__main:hover .product-gallery__zoom-hint {
  opacity: 1;
}

.product-gallery__zoom-hint svg {
  width: 18px;
  height: 18px;
}

/* --- Thumbnail strip --- */
.product-gallery__thumbs {
  display: flex;
  flex-direction: row;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 4px;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}

/* Hide scrollbar but keep scrollability */
.product-gallery__thumbs::-webkit-scrollbar { height: 4px; }
.product-gallery__thumbs::-webkit-scrollbar-thumb { background: #ccc; border-radius: 2px; }

.product-gallery__thumb {
  flex: 0 0 72px;
  width: 72px;
  height: 72px;
  border-radius: 4px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  transition: border-color 0.2s ease, opacity 0.2s ease;
  scroll-snap-align: start;
  background: #f4f4f4;
}

.product-gallery__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.product-gallery__thumb:hover {
  opacity: 0.8;
}

.product-gallery__thumb.is-active {
  border-color: #222;
  opacity: 1;
}

/* =============================================
   LIGHTBOX
   ============================================= */
.pg-lightbox {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.88);
  align-items: center;
  justify-content: center;
  animation: pgFadeIn 0.2s ease;
}

.pg-lightbox.is-open {
  display: flex;
}

@keyframes pgFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.pg-lightbox__inner {
  position: relative;
  max-width: 90vw;
  max-height: 90vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pg-lightbox__img {
  max-width: 90vw;
  max-height: 90vh;
  object-fit: contain;
  border-radius: 4px;
  display: block;
  animation: pgSlideIn 0.22s ease;
}

@keyframes pgSlideIn {
  from { transform: scale(0.95); opacity: 0; }
  to   { transform: scale(1);    opacity: 1; }
}

/* Nav buttons */
.pg-lightbox__btn {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,0.15);
  border: none;
  color: #fff;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
  z-index: 10000;
}
.pg-lightbox__btn:hover { background: rgba(255,255,255,0.3); }
.pg-lightbox__btn--prev { left: 16px; }
.pg-lightbox__btn--next { right: 16px; }
.pg-lightbox__btn svg { width: 22px; height: 22px; }

/* Close */
.pg-lightbox__close {
  position: fixed;
  top: 16px;
  right: 16px;
  background: rgba(255,255,255,0.15);
  border: none;
  color: #fff;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
  z-index: 10000;
}
.pg-lightbox__close:hover { background: rgba(255,255,255,0.3); }
.pg-lightbox__close svg { width: 20px; height: 20px; }

/* Counter */
.pg-lightbox__counter {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  color: rgba(255,255,255,0.7);
  font-size: 13px;
  letter-spacing: 0.05em;
  z-index: 10000;
}

@media screen and (max-width: 749px) {
  .product-gallery__thumb { flex: 0 0 60px; width: 60px; height: 60px; }
  .pg-lightbox__btn--prev { left: 6px; }
  .pg-lightbox__btn--next { right: 6px; }
}
</style>

{%- comment -%} =============================================
  BUILD MEDIA LIST
  ============================================= {%- endcomment -%}
{%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' -%}
{%- assign gallery_media = product.media -%}

{%- comment -%} Put featured variant image first {%- endcomment -%}
{%- assign featured_media = product.selected_or_first_available_variant.featured_media -%}

<div class="product-gallery" id="productGallery-{{ section.id }}">

  {%- comment -%} ——— MAIN IMAGE ——— {%- endcomment -%}
  <div class="product-gallery__main" id="pgMain-{{ section.id }}" data-lightbox-trigger>
    {%- if featured_media != null -%}
      <img
        id="pgMainImg-{{ section.id }}"
        src="{{ featured_media | img_url: '900x900', crop: 'center' }}"
        data-hires="{{ featured_media | img_url: '2000x2000' }}"
        alt="{{ featured_media.alt | escape | default: product.title }}"
        width="900"
        height="900"
        loading="eager"
      >
    {%- elsif product.featured_image != blank -%}
      <img
        id="pgMainImg-{{ section.id }}"
        src="{{ product.featured_image | img_url: '900x900', crop: 'center' }}"
        data-hires="{{ product.featured_image | img_url: '2000x2000' }}"
        alt="{{ product.featured_image.alt | escape | default: product.title }}"
        width="900"
        height="900"
        loading="eager"
      >
    {%- endif -%}

    <span class="product-gallery__zoom-hint" aria-hidden="true">
      <!-- magnifier icon -->
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        <line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
      </svg>
    </span>
  </div>

  {%- comment -%} ——— THUMBNAIL STRIP ——— {%- endcomment -%}
  {%- if product.media.size > 1 -%}
  <div class="product-gallery__thumbs" id="pgThumbs-{{ section.id }}" role="list">
    {%- if featured_media != null -%}
      <div
        class="product-gallery__thumb is-active"
        role="listitem"
        tabindex="0"
        data-media-id="{{ featured_media.id }}"
        data-src="{{ featured_media | img_url: '900x900', crop: 'center' }}"
        data-hires="{{ featured_media | img_url: '2000x2000' }}"
        data-alt="{{ featured_media.alt | escape | default: product.title }}"
        aria-label="{{ featured_media.alt | escape | default: product.title }}"
      >
        <img src="{{ featured_media | img_url: '160x160', crop: 'center' }}" alt="" loading="lazy" width="160" height="160">
      </div>
    {%- endif -%}

    {%- for media in product.media -%}
      {%- unless media.id == featured_media.id -%}
        <div
          class="product-gallery__thumb"
          role="listitem"
          tabindex="0"
          data-media-id="{{ media.id }}"
          data-src="{{ media | img_url: '900x900', crop: 'center' }}"
          data-hires="{{ media | img_url: '2000x2000' }}"
          data-alt="{{ media.alt | escape | default: product.title }}"
          aria-label="{{ media.alt | escape | default: product.title }}"
        >
          <img src="{{ media | img_url: '160x160', crop: 'center' }}" alt="" loading="lazy" width="160" height="160">
        </div>
      {%- endunless -%}
    {%- endfor -%}
  </div>
  {%- endif -%}

</div><!-- /product-gallery -->

{%- comment -%} ——— LIGHTBOX ——— {%- endcomment -%}
<div class="pg-lightbox" id="pgLightbox-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Product image viewer">
  <button class="pg-lightbox__close" id="pgClose-{{ section.id }}" aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <button class="pg-lightbox__btn pg-lightbox__btn--prev" id="pgPrev-{{ section.id }}" aria-label="Previous image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>

  <div class="pg-lightbox__inner">
    <img class="pg-lightbox__img" id="pgLightboxImg-{{ section.id }}" src="" alt="">
  </div>

  <button class="pg-lightbox__btn pg-lightbox__btn--next" id="pgNext-{{ section.id }}" aria-label="Next image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>

  <span class="pg-lightbox__counter" id="pgCounter-{{ section.id }}"></span>
</div>

<script>
(function() {
  var sectionId   = '{{ section.id }}';
  var gallery     = document.getElementById('productGallery-' + sectionId);
  var mainImg     = document.getElementById('pgMainImg-' + sectionId);
  var mainWrap    = document.getElementById('pgMain-' + sectionId);
  var thumbsWrap  = document.getElementById('pgThumbs-' + sectionId);
  var lightbox    = document.getElementById('pgLightbox-' + sectionId);
  var lbImg       = document.getElementById('pgLightboxImg-' + sectionId);
  var lbClose     = document.getElementById('pgClose-' + sectionId);
  var lbPrev      = document.getElementById('pgPrev-' + sectionId);
  var lbNext      = document.getElementById('pgNext-' + sectionId);
  var lbCounter   = document.getElementById('pgCounter-' + sectionId);

  if (!gallery || !mainImg) return;

  // Collect all thumb data into an array for lightbox navigation
  var mediaItems = [];
  var currentIndex = 0;

  function buildMediaItems() {
    mediaItems = [];
    var thumbs = gallery.querySelectorAll('.product-gallery__thumb');
    thumbs.forEach(function(t) {
      mediaItems.push({
        src:    t.dataset.src,
        hires:  t.dataset.hires,
        alt:    t.dataset.alt || '',
        el:     t
      });
    });
  }

  buildMediaItems();

  // ---- Thumbnail click → update main image ----
  function setActiveThumb(index) {
    var thumbs = gallery.querySelectorAll('.product-gallery__thumb');
    thumbs.forEach(function(t) { t.classList.remove('is-active'); });
    if (thumbs[index]) thumbs[index].classList.add('is-active');
    currentIndex = index;
  }

  function switchMain(index) {
    if (!mediaItems[index]) return;
    var item = mediaItems[index];
    mainImg.style.opacity = '0.5';
    setTimeout(function() {
      mainImg.src = item.src;
      mainImg.dataset.hires = item.hires;
      mainImg.alt = item.alt;
      mainImg.style.opacity = '1';
    }, 120);
    setActiveThumb(index);
  }

  if (thumbsWrap) {
    thumbsWrap.addEventListener('click', function(e) {
      var thumb = e.target.closest('.product-gallery__thumb');
      if (!thumb) return;
      var thumbs = Array.from(gallery.querySelectorAll('.product-gallery__thumb'));
      var idx = thumbs.indexOf(thumb);
      if (idx > -1) switchMain(idx);
    });

    thumbsWrap.addEventListener('keydown', function(e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      var thumb = e.target.closest('.product-gallery__thumb');
      if (!thumb) return;
      var thumbs = Array.from(gallery.querySelectorAll('.product-gallery__thumb'));
      var idx = thumbs.indexOf(thumb);
      if (idx > -1) switchMain(idx);
    });
  }

  // ---- Main image click → open lightbox ----
  function openLightbox(index) {
    if (!lightbox || !mediaItems[index]) return;
    currentIndex = index;
    lbImg.src = mediaItems[index].hires || mediaItems[index].src;
    lbImg.alt = mediaItems[index].alt;
    updateCounter();
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  function lbGoTo(index) {
    var total = mediaItems.length;
    currentIndex = (index + total) % total;
    lbImg.style.opacity = '0.3';
    setTimeout(function() {
      lbImg.src = mediaItems[currentIndex].hires || mediaItems[currentIndex].src;
      lbImg.alt = mediaItems[currentIndex].alt;
      lbImg.style.opacity = '1';
      updateCounter();
    }, 100);
    setActiveThumb(currentIndex);
  }

  function updateCounter() {
    if (lbCounter) lbCounter.textContent = (currentIndex + 1) + ' / ' + mediaItems.length;
  }

  if (mainWrap) {
    mainWrap.addEventListener('click', function() {
      openLightbox(currentIndex);
    });
  }

  if (lbClose)  lbClose.addEventListener('click', closeLightbox);
  if (lbPrev)   lbPrev.addEventListener('click', function() { lbGoTo(currentIndex - 1); });
  if (lbNext)   lbNext.addEventListener('click', function() { lbGoTo(currentIndex + 1); });

  // Close on backdrop click
  if (lightbox) {
    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) closeLightbox();
    });
  }

  // Keyboard nav
  document.addEventListener('keydown', function(e) {
    if (!lightbox || !lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape')      closeLightbox();
    if (e.key === 'ArrowLeft')   lbGoTo(currentIndex - 1);
    if (e.key === 'ArrowRight')  lbGoTo(currentIndex + 1);
  });

  // Touch swipe for lightbox
  var touchStartX = 0;
  if (lightbox) {
    lightbox.addEventListener('touchstart', function(e) {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    lightbox.addEventListener('touchend', function(e) {
      var diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        diff > 0 ? lbGoTo(currentIndex + 1) : lbGoTo(currentIndex - 1);
      }
    }, { passive: true });
  }

  // ---- Variant change → re-sync gallery ----
  // Shopify dispatches 'variant:change' or 'variantChange' on the section
  document.addEventListener('variant:change', function(e) {
    var variant = e.detail && e.detail.variant;
    if (!variant || !variant.featured_media) return;
    var targetId = String(variant.featured_media.id);
    var thumbs = Array.from(gallery.querySelectorAll('.product-gallery__thumb'));
    var idx = thumbs.findIndex(function(t) { return t.dataset.mediaId === targetId; });
    if (idx > -1) switchMain(idx);
  });

})();
</script>
