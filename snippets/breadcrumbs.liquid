<style>
  .breadcrumbs {
    margin: 0 0 2em;
  }
  .breadcrumbs__list {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }
  .breadcrumbs__item {
    display: inline-block;
  }
  .breadcrumbs__item:not(:last-child):after {
    border-style: solid;
    border-width: .10em .10em 0 0;
    content: '';
    display: inline-block;
    height: .20em;
    margin: 0 .20em;
    position: relative;
    transform: rotate(45deg);
    vertical-align: middle;
    width: .20em;
  }
  .breadcrumbs__link {
    text-decoration: underline;
  }
  .breadcrumbs__link[aria-current="page"] {
    color: inherit;
    font-weight: normal;
    text-decoration: none;
  }
  .breadcrumbs__link[aria-current="page"]:hover,
  .breadcrumbs__link[aria-current="page"]:focus {
    text-decoration: underline;
  }
</style>

{%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
{%- assign t = template | split: '.' | first -%}

<nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="/">Home</a>
    </li>
    {%- case t -%}
      {%- when 'page' -%}
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ page.url }}" aria-current="page">{{ page.title }}</a>
        </li>
      {%- when 'product' -%}
        {%- assign current_product_collection = collection -%}
        {%- if current_product_collection == blank and product.collections.size > 0 -%}
          {%- assign current_product_collection = product.collections.first -%}
        {%- endif -%}

        {%- if current_product_collection.url -%}
          {%- assign is_mapped = false -%}
          {%- assign direct_check = shop.metaobjects.collection_mapping[current_product_collection.handle] -%}
          {%- if direct_check == blank -%}
            {%- assign direct_check = shop.metaobjects.collection_mappings[current_product_collection.handle] -%}
          {%- endif -%}

          {%- if direct_check != blank -%}
            {%- assign is_mapped = true -%}
          {%- else -%}
            {%- for item in shop.metaobjects.collection_mapping.values -%}
              {%- if item.wrestler_collection == current_product_collection.handle or item.handle == current_product_collection.handle -%}
                {%- assign is_mapped = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- for item in shop.metaobjects.collection_mappings.values -%}
              {%- if item.wrestler_collection == current_product_collection.handle or item.handle == current_product_collection.handle -%}
                {%- assign is_mapped = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          
          {%- unless is_mapped -%}
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ current_product_collection.url }}" aria-current="page">{{ current_product_collection.title }}</a>
            </li>
          {%- endunless -%}
        {%- endif -%}
        
      {%- when 'collection' and collection.handle -%}
        {%- assign is_mapped = false -%}
        {%- assign direct_check = shop.metaobjects.collection_mapping[collection.handle] -%}
        {%- if direct_check == blank -%}
          {%- assign direct_check = shop.metaobjects.collection_mappings[collection.handle] -%}
        {%- endif -%}
        {%- if direct_check != blank -%}
          {%- assign is_mapped = true -%}
        {%- else -%}
          {%- for item in shop.metaobjects.collection_mapping.values -%}
            {%- if item.wrestler_collection == collection.handle or item.handle == collection.handle -%}
              {%- assign is_mapped = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- for item in shop.metaobjects.collection_mappings.values -%}
            {%- if item.wrestler_collection == collection.handle or item.handle == collection.handle -%}
              {%- assign is_mapped = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if current_tags -%}
          <li class="breadcrumbs__item">
            {{ collection.title | link_to: collection.url }}
          </li>
          <li class="breadcrumbs__item">
            {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+"}}{%- endcapture -%}
            <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + "}}</a>
          </li>
        {%- else -%}
          {%- unless is_mapped -%}
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ collection.url }}" aria-current="page">{{ collection.title }}</a>
            </li>
          {%- endunless -%}
        {%- endif -%}
      {%- when 'blog' -%}
        {%- if current_tags -%}
          <li class="breadcrumbs__item">
            {{ blog.title | link_to: blog.url }}
          </li>
          <li class="breadcrumbs__item">
            {%- capture tag_url -%}{{blog.url}}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
            <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + " }}</a>
          </li>
        {%- else -%}
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ blog.url }}" aria-current="page">{{ blog.title }}</a>
          </li>
        {%- endif -%}
      {%- when 'article' -%}
        <li class="breadcrumbs__item">
          {{ blog.title | link_to: blog.url }}
        </li>
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ article.url }}" aria-current="page">{{ article.title }}</a>
        </li>
      {%- else -%}
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ request.path }}" aria-current="page">{{ page_title }}</a>
        </li>
    {%- endcase -%}
  </ol>
</nav>
{%- endunless -%}