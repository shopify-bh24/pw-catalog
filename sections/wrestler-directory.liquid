<div class="page-width custom-wrestler-directory">
  {% if section.settings.heading != blank %}
    <h2 class="title h1">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="directory-table-wrapper">
    <table class="wrestler-table">
      <thead>
        <tr>
          <th>Wrestler Name</th>
          <th>Collection Link</th>
        </tr>
      </thead>
      <tbody>
        {% comment %} Loop through every row in your custom metaobject table {% endcomment %}
        {% for entry in shop.metaobjects.collection_mapping.values %}
          {% if entry.wrestler_name != blank and entry.wrestler_collection != blank %}
            <tr>
              <td class="wrestler-name-cell">
                <strong>{{ entry.wrestler_name }}</strong>
              </td>
              <td class="wrestler-link-cell">
                {% comment %} Automatically constructs the URL by appending the handle string {% endcomment %}
                <a href="/collections/{{ entry.wrestler_collection }}" class="button button--secondary">
                  View Collection
                </a>
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<style>
  .custom-wrestler-directory { margin: 60px auto; }
  .directory-table-wrapper { overflow-x: auto; margin-top: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); border-radius: 8px; border: 1px solid #e8e8e8; }
  .wrestler-table { width: 100%; border-collapse: collapse; background: #fff; text-align: left; }
  .wrestler-table th, .wrestler-table td { padding: 18px 24px; border-bottom: 1px solid #f0f0f0; }
  .wrestler-table th { background-color: #121212; color: #fff; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; }
  .wrestler-table tr:hover { background-color: #fcfcfc; }
  .wrestler-name-cell { font-size: 1.1rem; color: #121212; }
</style>

{% schema %}
{
  "name": "Wrestler Directory Table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Wrestler Merchandise Directory",
      "label": "Table Heading"
    }
  ],
  "presets": [
    {
      "name": "Wrestler Directory Table"
    }
  ]
}
{% endschema %}