{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}

<div class="template-search spaced-section">
  <div class="template-search__header page-width center">
    <h1 class="h2">Search Results</h1>
    <div class="template-search__search">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search">
        <div class="field">
          <input class="search__input field__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search...">
          <input name="options[prefix]" type="hidden" value="last">
          <button type="submit" class="search__button field__button">
            <svg class="icon icon-search" viewBox="0 0 18 18"><use xlink:href="#icon-search"></use></svg>
          </button>
        </div>
      </form>
    </div>
  </div>

  {%- if search.performed -%}
    <div id="ProductGridContainer" class="page-width">
      {% paginate search.results by 24 %}
        {%- assign product_results = search.results | where: "object_type", "product" -%}
        
        {%- if product_results.size == 0 -%}
          <div class="template-search__results collection collection--empty">
            <p>No products found for "{{ search.terms | escape }}".</p>
          </div>
        {%- else -%}
          <div class="template-search__results collection" id="product-grid">
            <ul class="grid grid--4-col-desktop grid--3-col-tablet grid--2-col product-grid" role="list">
              {%- for item in product_results -%}
                <li class="grid__item">
                  {% render 'product-card',
                    product_card_product: item,
                    media_size: 'square',
                    show_secondary_image: true,
                    add_image_padding: true,
                    show_vendor: false,
                    show_image_outline: true,
                    show_rating: false
                  %}
                </li>
              {%- endfor -%}
            </ul>
            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate %}
            {%- endif -%}
          </div>
        {%- endif -%}
      {% endpaginate %}
    </div>
  {%- endif -%}
</div>