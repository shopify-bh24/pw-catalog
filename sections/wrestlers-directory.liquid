<div class="page-width" style="padding: 20px 0;">
  
  <div class="pagination-controls" style="margin-bottom: 20px; text-align: right;">
    <label for="sort-select" style="margin-right: 10px;">Sort by:</label>
    <select id="sort-select" onchange="sortWrestlers(this.value)" style="padding: 5px; border-radius: 4px; border: 1px solid #ccc;">
      <option value="name-asc">Name (A-Z)</option>
      <option value="name-desc">Name (Z-A)</option>
      <option value="count-high">Most Items</option>
      <option value="count-low">Fewest Items</option>
    </select>
  </div>

  <div id="wrestler-grid" class="wrestler-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">
    {% for entry in metaobjects.collection_mapping.values %}
      {%- assign target_collection = collections[entry.wrestler_collection] -%}
      <div class="wrestler-card" 
           data-name="{{ entry.wrestler_name | downcase }}" 
           data-count="{{ target_collection.all_products_count | default: 0 }}"
           style="border: 1px solid #e1e1e1; padding: 15px; border-radius: 8px; text-align: center;">
        <a href="{{ target_collection.url | default: '#' }}">
          {% if target_collection.featured_image != blank %}
            <img src="{{ target_collection.featured_image | image_url: width: 400 }}" alt="{{ target_collection.title | escape }}" style="width: 100%; height: 250px; object-fit: cover; border-radius: 4px;">
          {% else %}
            <div style="height: 250px; background: #f4f4f4; display: flex; align-items: center; justify-content: center; border-radius: 4px;">No Image</div>
          {% endif %}
        </a>
        <h3 style="margin: 15px 0 5px; font-size: 1.2em;">{{ entry.wrestler_name }}</h3>
        <p style="margin: 0; font-size: 0.9em; color: #666;">{{ target_collection.all_products_count | default: 0 }} Items</p>
      </div>
    {% endfor %}
  </div>
</div>

<script>
function sortWrestlers(order) {
  const grid = document.getElementById('wrestler-grid');
  const cards = Array.from(grid.getElementsByClassName('wrestler-card'));
  
  cards.sort((a, b) => {
    if (order === 'name-asc') return a.dataset.name.localeCompare(b.dataset.name);
    if (order === 'name-desc') return b.dataset.name.localeCompare(a.dataset.name);
    if (order === 'count-high') return b.dataset.count - a.dataset.count;
    if (order === 'count-low') return a.dataset.count - b.dataset.count;
  });
  
  cards.forEach(card => grid.appendChild(card));
}
</script>

{% schema %}
{ "name": "Wrestler List", "settings": [], "presets": [{ "name": "Wrestler List" }] }
{% endschema %}