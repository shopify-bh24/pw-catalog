<div class="page-width" style="padding: 20px 0;">
  {%- assign limit = request.query_parameters.limit | default: 100 | plus: 0 -%}
  {%- assign page = request.query_parameters.page | default: 1 | plus: 0 -%}
  {%- assign offset = page | minus: 1 | times: limit -%}

  <div class="controls-container" style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
    <select onchange="window.location.href = '?limit=' + this.value + '&page=1';" style="padding: 5px;">
      <option value="25" {% if limit == 25 %}selected{% endif %}>25</option>
      <option value="50" {% if limit == 50 %}selected{% endif %}>50</option>
      <option value="100" {% if limit == 100 %}selected{% endif %}>100</option>
      <option value="250" {% if limit == 250 %}selected{% endif %}>250</option>
    </select>
  </div>

  <div class="wrestler-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">
    
    {% comment %} We loop through all, but use 'limit' and 'offset' to show only the right ones {% endcomment %}
    {% for entry in shop.metaobjects.collection_mapping.values limit: limit offset: offset %}
      {%- assign collection_handle = entry.wrestler_collection.value | strip -%}
      {%- assign target_collection = collections[collection_handle] -%}
      
      <div class="wrestler-card" style="border: 1px solid #e1e1e1; padding: 15px; border-radius: 8px; text-align: center;">
        <a href="{{ target_collection.url | default: '#' }}">
          {% if target_collection.featured_image != blank %}
            <img src="{{ target_collection.featured_image | image_url: width: 400 }}" alt="{{ target_collection.title | escape }}" loading="lazy" style="width: 100%; height: 250px; object-fit: cover; border-radius: 4px;">
          {% else %}
            <div style="height: 250px; background: #f4f4f4; display: flex; align-items: center; justify-content: center; border-radius: 4px;">No Image</div>
          {% endif %}
        </a>
        <h3 style="margin: 15px 0 5px; font-size: 1.2em;">{{ entry.wrestler_name }}</h3>
        <p style="margin: 0; font-size: 0.9em; color: #666;">{{ target_collection.all_products_count | default: 0 }} Items</p>
      </div>
    {% endfor %}
  </div>

  {% comment %} Manual Pagination Links {% endcomment %}
  <div class="pagination" style="text-align: center; margin-top: 30px;">
    {% assign total_items = shop.metaobjects.collection_mapping.values.size %}
    {% assign total_pages = total_items | divided_by: limit | plus: 1 %}
    
    {% for i in (1..total_pages) %}
      <a href="?limit={{ limit }}&page={{ i }}" style="margin: 0 5px; {% if i == page %}font-weight:bold;{% endif %}">{{ i }}</a>
    {% endfor %}
  </div>
</div>