{%- assign limit = request.query_parameters.limit | default: 50 | plus: 0 -%}

{% comment %} 
  1. Always paginate by a fixed number (e.g., 100) to keep Shopify happy.
  2. Use the 'limit' variable inside the 'for' loop to control display.
{% endcomment %}

{% paginate metaobjects.collection_mapping.values by 100 %}
  {% for entry in metaobjects.collection_mapping.values limit: limit %}
    {%- assign collection_handle = entry.wrestler_collection -%}
    {%- assign target_collection = collections[collection_handle] -%}
    
    {% comment %} ... Your wrestler-card code here ... {% endcomment %}
  {% endfor %}

  <div style="grid-column: 1 / -1; text-align: center; margin-top: 20px;">
    {{ paginate | default_pagination }}
  </div>
{% endpaginate %}