<div class="page-width" style="padding: 20px 0;">

  {% paginate shop.metaobjects.collection_mapping.values by 1000 %}

    <div style="display:flex; justify-content:flex-end; align-items:center; margin-bottom:20px; gap:10px; flex-wrap:wrap;">
      
      <label for="sort-select" style="font-size:0.9em; color:#555;">Sort by:</label>
      <select id="sort-select" style="padding:6px 10px; border:1px solid #d1d1d1; border-radius:6px; font-size:0.9em; background:#fff; cursor:pointer;">
        <option value="az">A → Z</option>
        <option value="za">Z → A</option>
        <option value="most">Most Products</option>
        <option value="least">Fewest Products</option>
      </select>

      <label for="per-page-select" style="font-size:0.9em; color:#555;">Items per page:</label>
      <select id="per-page-select" style="padding:6px 10px; border:1px solid #d1d1d1; border-radius:6px; font-size:0.9em; background:#fff; cursor:pointer;">
        <option value="25">25</option>
        <option value="50" selected>50</option>
        <option value="100">100</option>
        <option value="250">250</option>
      </select>

    </div>

    <div id="wrestler-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:20px;">
      {% for entry in shop.metaobjects.collection_mapping.values %}
        {%- assign collection_handle = entry.wrestler_collection.value | strip -%}
        {%- assign target_collection = collections[collection_handle] -%}
        <div class="wrestler-card"
             data-name="{{ entry.wrestler_name | downcase | escape }}"
             data-count="{{ target_collection.all_products_count | default: 0 }}"
             style="border:1px solid #e1e1e1; padding:15px; border-radius:8px; text-align:center;">
          <a href="{{ target_collection.url | default: '#' }}">
            {% if target_collection.featured_image != blank %}
              <img src="{{ target_collection.featured_image | image_url: width: 400 }}"
                   alt="{{ target_collection.title | escape }}"
                   loading="lazy"
                   style="width:100%; height:250px; object-fit:cover; border-radius:4px;">
            {% else %}
              <div style="height:250px; background:#f4f4f4; display:flex; align-items:center; justify-content:center; border-radius:4px;">No Image</div>
            {% endif %}
          </a>
          <h3 style="margin:15px 0 5px; font-size:1.2em;">{{ entry.wrestler_name }}</h3>
          <p style="margin:0; font-size:0.9em; color:#666;">
            <a href="{{ target_collection.url | default: '#' }}" style="color:#666; text-decoration:none;">
              {{ target_collection.all_products_count | default: 0 }} Items
            </a>
          </p>
        </div>
      {% endfor %}
    </div>

    <div id="pagination-controls" style="text-align:center; margin-top:30px; display:flex; justify-content:center; gap:6px; flex-wrap:wrap;"></div>

  {% endpaginate %}
</div>

<script>
(function () {
  var grid = document.getElementById('wrestler-grid');
  var cards = Array.from(grid.querySelectorAll('.wrestler-card'));
  var select = document.getElementById('per-page-select');
  var sortSelect = document.getElementById('sort-select');
  var controls = document.getElementById('pagination-controls');
  var currentPage = 1;

  var params = new URLSearchParams(window.location.search);
  var savedPerPage = parseInt(params.get('per_page'));
  if ([25, 50, 100, 250].indexOf(savedPerPage) !== -1) {
    select.value = savedPerPage;
  }
  var savedSort = params.get('sort');
  if (savedSort) sortSelect.value = savedSort;

  function getPerPage() { return parseInt(select.value); }
  function getSort() { return sortSelect.value; }

  function sortCards() {
    var sorted = cards.slice().sort(function(a, b) {
      switch (getSort()) {
        case 'az':   return a.dataset.name.localeCompare(b.dataset.name);
        case 'za':   return b.dataset.name.localeCompare(a.dataset.name);
        case 'most': return parseInt(b.dataset.count) - parseInt(a.dataset.count);
        case 'least':return parseInt(a.dataset.count) - parseInt(b.dataset.count);
        default:     return 0;
      }
    });
    sorted.forEach(function(card) { grid.appendChild(card); });
    cards = sorted;
  }

  function render() {
    sortCards();
    var perPage = getPerPage();
    var totalPages = Math.ceil(cards.length / perPage);
    if (currentPage > totalPages) currentPage = 1;

    var start = (currentPage - 1) * perPage;
    var end = start + perPage;

    cards.forEach(function (card, i) {
      card.style.display = (i >= start && i < end) ? '' : 'none';
    });

    renderControls(totalPages);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderControls(totalPages) {
    controls.innerHTML = '';
    if (totalPages <= 1) return;

    var btnStyle = 'padding:7px 13px; border:1px solid #d1d1d1; border-radius:5px; background:#fff; cursor:pointer; font-size:0.9em; color:#333; text-decoration:none; display:inline-block;';
    var activeStyle = 'padding:7px 13px; border:1px solid #333; border-radius:5px; background:#333; cursor:default; font-size:0.9em; color:#fff; display:inline-block;';

    if (currentPage > 1) {
      var prev = document.createElement('a');
      prev.href = '#'; prev.innerHTML = '&laquo; Prev'; prev.style.cssText = btnStyle;
      prev.addEventListener('click', function(e){ e.preventDefault(); currentPage--; render(); });
      controls.appendChild(prev);
    }

    var pages = [];
    for (var i = 1; i <= totalPages; i++) {
      if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
        pages.push(i);
      }
    }

    var last = 0;
    pages.forEach(function(p) {
      if (last && p - last > 1) {
        var dots = document.createElement('span');
        dots.textContent = '…';
        dots.style.cssText = 'padding:7px 6px; font-size:0.9em; color:#999;';
        controls.appendChild(dots);
      }
      var btn = document.createElement('a');
      btn.href = '#'; btn.textContent = p;
      btn.style.cssText = (p === currentPage) ? activeStyle : btnStyle;
      if (p !== currentPage) {
        btn.addEventListener('click', (function(pg){ return function(e){ e.preventDefault(); currentPage = pg; render(); }; })(p));
      }
      controls.appendChild(btn);
      last = p;
    });

    if (currentPage < totalPages) {
      var next = document.createElement('a');
      next.href = '#'; next.innerHTML = 'Next &raquo;'; next.style.cssText = btnStyle;
      next.addEventListener('click', function(e){ e.preventDefault(); currentPage++; render(); });
      controls.appendChild(next);
    }
  }

  select.addEventListener('change', function () {
    currentPage = 1;
    var url = new URL(window.location.href);
    url.searchParams.set('per_page', select.value);
    window.history.replaceState({}, '', url.toString());
    render();
  });

  sortSelect.addEventListener('change', function () {
    currentPage = 1;
    var url = new URL(window.location.href);
    url.searchParams.set('sort', sortSelect.value);
    window.history.replaceState({}, '', url.toString());
    render();
  });

  render();
})();
</script>

{% schema %}
{
  "name": "Wrestler List",
  "settings": [],
  "presets": [{ "name": "Wrestler List" }]
}
{% endschema %}