<div class="page-width">
  <h2>Wrestler List</h2>
  <div class="wrestler-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px;">
    {% for entry in metaobjects.collection_mapping.values %}
      <div class="wrestler-card" style="border: 1px solid #ddd; padding: 10px;">
        <p><strong>Name:</strong> {{ entry.wrestler-name }}</p>
        <p><strong>Collection:</strong> {{ entry.wrestler-collection }}</p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Wrestler List",
  "settings": [],
  "presets": [
    {
      "name": "Wrestler List"
    }
  ]
}
{% endschema %}