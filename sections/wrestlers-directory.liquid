<div id="wrestler-container" class="any-random-grid">
  {% comment %} 
    Use the handle 'collection-mapping' (with a dash) 
    and the .values property.
  {% endcomment %}
  {% for entry in shop.metaobjects.collection-mapping.values %}
    {% assign col_handle = entry.wrestler-collection.value | strip %}
    {% assign target = collections[col_handle] %}
    
    {% if target != blank %}
      <div class="wrestler-item" data-name="{{ target.title | escape }}" data-count="{{ target.products_count }}">
        <a href="{{ target.url }}">
          {% if target.featured_image %}
            <img src="{{ target.featured_image | image_url: width: 400 }}" alt="{{ target.title | escape }}" loading="lazy" width="400" height="400">
          {% endif %}
          <h3>{{ target.title }} ({{ target.products_count }} items)</h3>
        </a>
      </div>
    {% endif %}
  {% else %}
    <p>No entries found. Please verify that the metaobject handle is 'collection-mapping' and the field is 'wrestler-collection'.</p>
  {% endfor %}
</div>