<div id="wrestler-container" class="any-random-grid">
  {% assign all_entries = shop.metaobjects.collection_mapping.all %}
  <p>Total entries found: {{ all_entries.size }}</p>
  
  {% for entry in all_entries %}
    {% assign col_handle = entry.wrestler_collection.value | strip %}
    {% assign target = collections[col_handle] %}
    
    <div class="wrestler-item" data-name="{{ target.title | default: 'Unknown' | escape }}" data-count="{{ target.products_count | default: 0 }}">
      <a href="{{ target.url | default: '#' }}">
        {% if target.featured_image %}
          <img src="{{ target.featured_image | image_url: width: 400 }}" alt="{{ target.title | escape }}" loading="lazy" width="400" height="400">
        {% endif %}
        <h3>{{ target.title | default: 'No Title Found' }} ({{ target.products_count }} items)</h3>
      </a>
    </div>
  {% else %}
    <p>No entries found in collection_mapping. Please check your Metaobject definition name.</p>
  {% endfor %}
</div>