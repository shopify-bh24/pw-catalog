<div class="page-width" style="padding: 20px 0;">
  
  {%- assign paginate_by = request.query_parameters.paginateBy | default: 25 | plus: 0 -%}
  {%- if paginate_by == 0 -%}{%- assign paginate_by = 1000 -%}{%- endif -%}
  {%- assign sort_by = request.query_parameters.sort_by | default: 'name_asc' -%}

  <div class="pagination-controls" style="margin-bottom: 20px; text-align: right; display: flex; gap: 10px; justify-content: flex-end;">
    
    {%- comment -%} Quantity Dropdown {%- endcomment -%}
    <select onchange="window.location.href = window.location.pathname + '?paginateBy=' + this.value + '&sort_by={{ sort_by }}';">
      <option value="25" {% if paginate_by == 25 %}selected{% endif %}>Show 25</option>
      <option value="50" {% if paginate_by == 50 %}selected{% endif %}>Show 50</option>
      <option value="1000" {% if paginate_by == 1000 %}selected{% endif %}>Show All</option>
    </select>

    {%- comment -%} Sort Dropdown {%- endcomment -%}
    <select onchange="window.location.href = window.location.pathname + '?paginateBy={{ paginate_by }}&sort_by=' + this.value;">
      <option value="name_asc" {% if sort_by == 'name_asc' %}selected{% endif %}>Name (A-Z)</option>
      <option value="name_desc" {% if sort_by == 'name_desc' %}selected{% endif %}>Name (Z-A)</option>
    </select>
  </div>

  <div class="wrestler-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">
    {%- assign wrestler_list = metaobjects.collection_mapping.values -%}
    {%- assign count = 0 -%}

    {% for entry in wrestler_list %}
      {%- if count < paginate_by -%}
        {%- assign target_collection = collections[entry.wrestler_collection] -%}
        
        <div class="wrestler-card" style="border: 1px solid #e1e1e1; padding: 15px; border-radius: 8px; text-align: center;">
          <a href="{{ target_collection.url | default: '#' }}">
            {% if target_collection.featured_image != blank %}
              <img src="{{ target_collection.featured_image | image_url: width: 400 }}" alt="{{ target_collection.title | escape }}" style="width: 100%; height: 250px; object-fit: cover; border-radius: 4px;">
            {% else %}
              <div style="height: 250px; background: #f4f4f4; display: flex; align-items: center; justify-content: center; border-radius: 4px;">No Image</div>
            {% endif %}
          </a>
          <h3 style="margin: 15px 0 5px; font-size: 1.2em;">{{ entry.wrestler_name }}</h3>
        </div>
        {%- assign count = count | plus: 1 -%}
      {%- endif -%}
    {% endfor %}
  </div>
</div>