<div class="page-width" style="padding: 20px 0;">
  
  {%- comment -%} 1. Setup Pagination Variables {%- endcomment -%}
  {%- assign paginate_by = request.query_parameters.paginateBy | default: 25 | plus: 0 -%}
  {%- if paginate_by == 0 -%}{%- assign paginate_by = 1000 -%}{%- endif -%}
  
  {%- assign current_page = request.query_parameters.page | default: 1 | plus: 0 -%}
  {%- assign offset = current_page | minus: 1 | times: paginate_by -%}
  
  {%- assign wrestler_list = metaobjects.collection_mapping.values -%}
  {%- assign total_items = wrestler_list.size -%}
  {%- assign total_pages = total_items | divided_by: paginate_by | plus: 1 -%}

  {%- comment -%} 2. Define array outside the loop to avoid syntax errors {%- endcomment -%}
  {%- assign options_array = "25,50,100,ALL" | split: "," -%}

  <div class="pagination-controls" style="margin-bottom: 20px; text-align: right;">
    <label for="paginate-select" style="margin-right: 10px; font-weight: bold;">Show:</label>
    <select id="paginate-select" 
            onchange="window.location.href = '{{ request.path }}?paginateBy=' + this.value + '&page=1';" 
            style="padding: 5px; border-radius: 4px; border: 1px solid #ccc; cursor: pointer;">
      
      {% for val in options_array %}
        {%- assign v = val | downcase -%}
        {%- assign v_num = 1000 -%}
        {%- if v != 'all' -%}{%- assign v_num = v | plus: 0 -%}{%- endif -%}
        <option value="{{ v_num }}" {% if paginate_by == v_num %}selected{% endif %}>{{ val }}</option>
      {% endfor %}
    </select>
  </div>

  {%- comment -%} 3. Display Sliced Grid {%- endcomment -%}
  <div class="wrestler-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">
    {% assign display_list = wrestler_list | slice: offset, paginate_by %}
    
    {% for entry in display_list %}
        {%- assign collection_handle = entry.wrestler_collection -%}
        {%- assign target_collection = collections[collection_handle] -%}
        
        <div class="wrestler-card" style="border: 1px solid #e1e1e1; padding: 15px; border-radius: 8px; text-align: center;">
          <a href="{{ target_collection.url }}">
            {% if target_collection.featured_image != blank %}
              <img src="{{ target_collection.featured_image | image_url: width: 400 }}" alt="{{ target_collection.title | escape }}" style="width: 100%; height: 250px; object-fit: cover; border-radius: 4px;">
            {% else %}
              <div style="height: 250px; background: #f4f4f4; display: flex; align-items: center; justify-content: center; border-radius: 4px;">No Image</div>
            {% endif %}
          </a>
          <h3 style="margin: 15px 0 5px; font-size: 1.2em;">{{ entry.wrestler_name }}</h3>
          <p style="margin: 0; font-size: 0.9em; color: #666;">
            <a href="{{ target_collection.url }}" style="color: #666; text-decoration: none;">{{ target_collection.all_products_count }} Items</a>
          </p>
        </div>
    {% endfor %}
  </div>

  {%- comment -%} 4. Manual Pagination Links {%- endcomment -%}
  {% if total_pages > 1 %}
    <div style="margin-top: 30px; text-align: center;">
      {% for i in (1..total_pages) %}
        <a href="{{ request.path }}?paginateBy={{ paginate_by }}&page={{ i }}" 
           style="padding: 5px 10px; margin: 0 5px; border: 1px solid #ccc; text-decoration: none; {% if i == current_page %}font-weight:bold; background:#eee;{% endif %}">
           {{ i }}
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Wrestler List",
  "settings": [],
  "presets": [{ "name": "Wrestler List" }]
}
{% endschema %}