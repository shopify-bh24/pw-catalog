<div class="page-width" style="padding: 20px 0;">
  <div class="wrestler-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">
    {% for entry in metaobjects.collection_mapping.values %}
      <div class="wrestler-card" style="border: 1px solid #e1e1e1; padding: 15px; border-radius: 8px;">
        <h3 style="margin-top: 0;">Name: {{ entry.wrestler_name }}</h3>
        <p>
          Collection: 
          <a href="https://pwcatalog.com/collections/{{ entry.wrestler_collection }}">
            {{ entry.wrestler_collection }}
          </a>
        </p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Wrestler List",
  "settings": [],
  "presets": [
    {
      "name": "Wrestler List"
    }
  ]
}
{% endschema %}