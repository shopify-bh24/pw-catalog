<div class="page-width">
  <p>Count of entries: {{ metaobjects.collection_mapping.values.size }}</p>
  
  {% for entry in metaobjects.collection_mapping.values limit: 5 %}
    <p>Entry {{ forloop.index }}: {{ entry['wrestler-name'] }}</p>
  {% else %}
    <p>The system cannot find any entries for 'collection_mapping'.</p>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Wrestler Debug",
  "settings": [],
  "presets": [{ "name": "Wrestler Debug" }]
}
{% endschema %}