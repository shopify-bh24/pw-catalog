<section class="page-width wrestler-directory">
  <h1>{{ page.title }}</h1>
  
  <div id="wrestler-container" class="any-random-grid"></div>

  <div class="pagination-controls">
    <button id="prev-btn">Previous</button>
    <span id="page-info"></span>
    <button id="next-btn">Next</button>
  </div>
</section>

{% comment %} 
  Store the data in a hidden JSON script tag for JS to read 
{% endcomment %}
<script id="wrestler-data" type="application/json">
  [
    {% for entry in shop.metaobjects['collection_mapping'].values %}
      {
        "title": "{{ collections[entry.wrestler_collection.value].title | escape }}",
        "url": "{{ collections[entry.wrestler_collection.value].url }}",
        "count": {{ collections[entry.wrestler_collection.value].products_count | default: 0 }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
</script>