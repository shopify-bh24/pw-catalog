<section class="page-width wrestler-directory">
  <h1>{{ page.title }}</h1>
  
  <div id="wrestler-container" class="any-random-grid"></div>

  <div class="pagination-controls">
    <button id="prev-btn">Previous</button>
    <span id="page-info"></span>
    <button id="next-btn">Next</button>
  </div>
</section>

<script id="wrestler-data" type="application/json">
  [
    {% for entry in shop.metaobjects['collection_mapping'].values %}
      {% assign target = collections[entry.wrestler_collection.value] %}
      {
        "title": "{{ target.title | escape }}",
        "url": "{{ target.url }}",
        "count": {{ target.products_count | default: 0 }},
        "image": "{{ target.featured_image | image_url: width: 400 }}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
</script>