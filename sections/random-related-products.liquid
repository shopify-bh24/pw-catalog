<div class="product-card">
  <div class="product-card__image">
    <a href="{{ product_card_product.url }}">
      <img src="{{ product_card_product.featured_image | img_url: 'medium' }}" alt="{{ product_card_product.title }}">
    </a>
  </div>

  <div class="product-card__info">
    <h3>
      <a href="{{ product_card_product.url }}">{{ product_card_product.title }}</a>
    </h3>
  </div>

  <div class="product-card__actions">
    {% form 'product', product_card_product %}
      <button type="submit" class="button">Add to Collection</button>
    {% endform %}
    <button class="button button--secondary">Add to Wishlist</button>
  </div>
</div>