<section class="random-products-section page-width">
  <h2 class="title">{{ section.settings.heading | escape }}</h2>
  <ul id="random-products-list" class="grid grid--2-col product-grid grid--4-col-desktop" role="list">
    </ul>
</section>

<script>
document.addEventListener("DOMContentLoaded", async function() {
  const container = document.getElementById("random-products-list");
  const limit = {{ section.settings.products_to_show | default: 8 }};
  
  // 1. Generate 8 unique random page numbers (assuming 500 pages)
  const pages = new Set();
  while(pages.size < limit) pages.add(Math.floor(Math.random() * 500) + 1);

  // 2. Fetch one product from each random page
  const fetchProduct = async (page) => {
    const res = await fetch(`/collections/all/products.json?limit=1&page=${page}`);
    const data = await res.json();
    return data.products[0] ? data.products[0].handle : null;
  };

  const handles = await Promise.all(Array.from(pages).map(fetchProduct));

  // 3. Render the cards
  container.innerHTML = handles.filter(h => h).map(handle => `
    <li class="grid__item">
      <div class="product-card-loader" data-handle="${handle}">Loading...</div>
    </li>
  `).join('');
});
</script>