<section class="random related-products page-width">
  <h2 class="product-recommendations__heading title">{{ section.settings.heading | escape }}</h2>
  <div id="random-products-list" class="grid grid--2-col product-grid grid--4-col-desktop">
    {% comment %} Only passing data, no heavy rendering here {% endcomment %}
    {% for handle in collection_handles limit: 60 %}
      {% assign prod = collections[handle].products.first %}
      {% if prod %}
        <div class="prod-data-item" 
             data-title="{{ prod.title | escape }}" 
             data-url="{{ prod.url }}" 
             data-img="{{ prod.featured_image | image_url: width: 400 }}">
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const container = document.getElementById("random-products-list");
    const items = Array.from(container.querySelectorAll('.prod-data-item'));
    const limit = {{ section.settings.products_to_show | default: 8 }};
    
    const selected = items.sort(() => 0.5 - Math.random()).slice(0, limit);
    
    container.innerHTML = selected.map(item => `
      <div class="grid__item">
        <a href="${item.dataset.url}">
          <img src="${item.dataset.img}" alt="${item.dataset.title}" loading="lazy" style="width:100%;">
          <p>${item.dataset.title}</p>
        </a>
      </div>
    `).join('');
  });
</script>

{% schema %}
{
  "name": "Random Products",
  "settings": [
    { "type": "text", "id": "heading", "default": "Random Items", "label": "Heading" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "default": 8, "label": "Count" }
  ],
  "presets": [{ "name": "Random Products" }]
}
{% endschema %}