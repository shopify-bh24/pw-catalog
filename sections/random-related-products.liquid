{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'section-product-recommendations.css' | asset_url | stylesheet_tag }}

<section class="random related-products page-width spaced-section">
  <h2 class="product-recommendations__heading title">
    {{ section.settings.heading | escape }}
  </h2>
  <ul
    id="rp-list"
    class="grid grid--2-col product-grid grid--3-col-tablet grid--one-third-max grid--4-col-desktop grid--quarter-max"
    role="list">
    {% for i in (1..8) %}
      <li class="grid__item rp-skel-item">
        <div class="card-wrapper">
          <div class="rp-skel-img"></div>
          <div class="card-information">
            <div class="rp-skel-line" style="width:90%"></div>
            <div class="rp-skel-line" style="width:60%;margin-top:6px"></div>
            <div class="rp-skel-btns">
              <div class="rp-skel-btn"></div>
              <div class="rp-skel-btn"></div>
            </div>
          </div>
        </div>
      </li>
    {% endfor %}
  </ul>
</section>

<script id="rp-handles" type="application/json">
[{% for c in collections %}{% if c.products_count > 0 %}{% unless forloop.first %},{% endunless %}"{{ c.handle }}"{% endif %}{% endfor %}]
</script>

<script>
(function () {
  var STORE = 'https://pwcatalog.com';
  var NEED  = {{ section.settings.products_to_show | default: 8 }};
  var list  = document.getElementById('rp-list');
  var hdlEl = document.getElementById('rp-handles');
  if (!list || !hdlEl) return;

  var allHandles;
  try { allHandles = JSON.parse(hdlEl.textContent); } catch(e) { return; }
  if (!allHandles.length) return;

  function shuffle(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = a[i]; a[i] = a[j]; a[j] = t;
    }
    return a;
  }

  function buildCard(p) {
    var img1 = p.images && p.images.length > 0 ? p.images[0].src.replace(/(\.[^.?]+)(\?.*)?$/, '_400x$1') : '';
    var img2 = p.images && p.images.length > 1 ? p.images[1].src.replace(/(\.[^.?]+)(\?.*)?$/, '_400x$1') : img1;
    var url = '/products/' + p.handle;
    var id  = p.id;
    
    return (
      '<li class="grid__item p-card-hide">' +
        '<div class="card-wrapper">' +
          '<a href="' + url + '" class="card card--product card--outline">' +
            '<div class="card__media">' +
              '<img src="' + img1 + '" alt="' + p.title.replace(/"/g,'&quot;') + '" class="main-img" loading="lazy" width="400" height="533">' +
              '<img src="' + img2 + '" alt="' + p.title.replace(/"/g,'&quot;') + '" class="secondary-img" loading="lazy" width="400" height="533">' +
            '</div>' +
          '</a>' +
          '<div class="card-information">' +
            '<div class="card-information__wrapper">' +
              '<h3 class="card-information__text h5">' + p.title + '</h3>' +
              '<div class="product-btn">' +
                '<a href="/account/login" class="collection-btn" data-product-id="' + id + '">Add to Collection &#10084;</a>' +
                '<a href="/account/login" class="wishlist-btn" data-product-id="' + id + '">Add to Wishlist &#10084;</a>' +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</li>'
    );
  }

  function fetchOne(handle) {
    var page = Math.floor(Math.random() * 5) + 1;
    return fetch(STORE + '/collections/' + handle + '/products.json?limit=10&page=' + page)
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var prods = d.products || [];
        if (!prods.length) return fetch(STORE + '/collections/' + handle + '/products.json?limit=10&page=1').then(function(r2) { return r2.json(); }).then(function(d2) { return d2.products || []; });
        return prods;
      })
      .then(function(prods) { return prods.length ? prods[Math.floor(Math.random() * prods.length)] : null; })
      .catch(function() { return null; });
  }

  function run() {
    var picked = shuffle(allHandles).slice(0, NEED);
    Promise.all(picked.map(fetchOne)).then(function(products) {
      products = products.filter(Boolean);
      if (products.length < NEED) {
        var extras = shuffle(allHandles).filter(function(h) { return picked.indexOf(h) === -1; }).slice(0, NEED - products.length);
        return Promise.all(extras.map(fetchOne)).then(function(more) { return products.concat(more.filter(Boolean)); });
      }
      return products;
    }).then(function(products) {
      if (!products.length) return;
      list.innerHTML = products.slice(0, NEED).map(buildCard).join('');
      document.dispatchEvent(new CustomEvent('rp:loaded'));
    });
  }

  if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 2000 }); else setTimeout(run, 300);
})();
</script>

<style>
  /* Skeleton Loading Styles */
  .rp-skel-img { width: 100%; aspect-ratio: 3/4; background: linear-gradient(90deg,#f0f0f0 25%,#e4e4e4 50%,#f0f0f0 75%); background-size: 200% 100%; animation: rp-sh 1.4s infinite; border-radius: 4px; }
  .rp-skel-line { height: 13px; border-radius: 3px; background: linear-gradient(90deg,#f0f0f0 25%,#e4e4e4 50%,#f0f0f0 75%); background-size: 200% 100%; animation: rp-sh 1.4s infinite; }
  .rp-skel-btns { display:flex; gap:4px; margin-top:8px; }
  .rp-skel-btn { flex:1; height:28px; border-radius:3px; background: linear-gradient(90deg,#f0f0f0 25%,#e4e4e4 50%,#f0f0f0 75%); background-size: 200% 100%; animation: rp-sh 1.4s infinite; }
  @keyframes rp-sh { 0% { background-position:200% 0; } 100% { background-position:-200% 0; } }

  /* Image Hover and Swap Styles */
  .card__media { position: relative; overflow: hidden; aspect-ratio: 3/4; }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease, opacity 0.3s ease; position: absolute; top: 0; left: 0; }
  .main-img { opacity: 1; z-index: 1; }
  .secondary-img { opacity: 0; z-index: 0; }
  .card-wrapper:hover .main-img { opacity: 0; }
  .card-wrapper:hover .secondary-img { opacity: 1; transform: scale(1.05); }
  .card-wrapper:hover .main-img { transform: scale(1.05); }
</style>

{% schema %}
{
  "name": "Random Products",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    { "type": "text", "id": "heading", "default": "Random items from our catalog!!", "label": "Heading" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "default": 8, "label": "Number of products to display" }
  ],
  "presets": [{ "name": "Random Products" }]
}
{% endschema %}