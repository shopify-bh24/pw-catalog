{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'section-product-recommendations.css' | asset_url | stylesheet_tag }}

{% comment %}
  random-related-products.liquid
  ─────────────────────────────────────────────────────
  STRATEGY: Use /collections/all/products.json with a
  random page offset to get truly random products from
  across all 70K products in the store.
  - Page loads instantly with skeletons
  - JS fetches after idle — zero page load impact
  - Different products every single refresh
{% endcomment %}

{% assign total_products = 70000 %}
{% assign products_per_page = 20 %}
{% assign total_pages = total_products | divided_by: products_per_page %}

<section class="random related-products page-width spaced-section">
  <h2 class="product-recommendations__heading title">
    {{ section.settings.heading | escape }}
  </h2>

  <ul
    id="rp-list"
    class="grid grid--2-col product-grid grid--3-col-tablet grid--one-third-max grid--4-col-desktop grid--quarter-max"
    role="list">
    {% comment %} Skeleton placeholders — replaced by JS {% endcomment %}
    {% for i in (1..8) %}
      <li class="grid__item rp-skel-item">
        <div class="card-wrapper">
          <div class="rp-skel-img"></div>
          <div class="card-information">
            <div class="rp-skel-line" style="width:90%"></div>
            <div class="rp-skel-line" style="width:60%;margin-top:6px"></div>
            <div class="rp-skel-btns">
              <div class="rp-skel-btn"></div>
              <div class="rp-skel-btn"></div>
            </div>
          </div>
        </div>
      </li>
    {% endfor %}
  </ul>
</section>

<script>
(function () {
  var STORE        = 'https://pwcatalog.com';
  var NEED         = {{ section.settings.products_to_show | default: 8 }};
  var TOTAL_PAGES  = {{ total_pages }};
  var list         = document.getElementById('rp-list');
  if (!list) return;

  // ── Helpers ───────────────────────────────────────────
  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
    }
    return arr;
  }

  function buildCard(p) {
    var img = p.images && p.images.length
      ? p.images[0].src.replace(/(\.[^.?]+)(\?.*)?$/, '_400x$1')
      : '';
    var url = '/products/' + p.handle;
    var id  = p.id;

    return '<li class="grid__item p-card-hide">' +
      '<div class="card-wrapper">' +
        '<a href="' + url + '" class="card card--product card--outline">' +
          (img ? '<img src="' + img + '" alt="' +
            p.title.replace(/"/g, '&quot;') +
            '" loading="lazy" width="400" height="533" style="width:100%;aspect-ratio:3/4;object-fit:cover;">' : '') +
        '</a>' +
        '<div class="card-information">' +
          '<div class="card-information__wrapper">' +
            '<h3 class="card-information__text h5">' + p.title + '</h3>' +
            '<span class="caption-large light"></span>' +
            '<div class="product-btn">' +
              '<a href="/account/login"' +
                ' class="collection-btn"' +
                ' data-customer-id=""' +
                ' data-product-id="' + id + '"' +
                ' data-product-price="0"' +
                ' data-action="add_to_collection"' +
                ' data-collection-id="">' +
                'Add to Collection &#10084;' +
              '</a>' +
              '<a href="/account/login"' +
                ' class="wishlist-btn"' +
                ' data-customer-id=""' +
                ' data-product-id="' + id + '"' +
                ' data-product-price="0"' +
                ' data-action="add_to_wishlist"' +
                ' data-collection-id="">' +
                'Add to Wishlist &#10084;' +
              '</a>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>' +
    '</li>';
  }

  function fetchPage(page) {
    return fetch(STORE + '/collections/all/products.json?limit=20&page=' + page)
      .then(function(r) { return r.json(); })
      .then(function(d) { return d.products || []; })
      .catch(function() { return []; });
  }

  function run() {
    // Pick 2 completely random pages spread across all 70K products
    var page1 = Math.floor(Math.random() * TOTAL_PAGES) + 1;
    var page2 = Math.floor(Math.random() * TOTAL_PAGES) + 1;
    // Make sure they're different
    while (page2 === page1) {
      page2 = Math.floor(Math.random() * TOTAL_PAGES) + 1;
    }

    Promise.all([fetchPage(page1), fetchPage(page2)])
      .then(function(results) {
        var products = shuffle(results[0].concat(results[1]));

        // If we didn't get enough, fetch one more random page
        if (products.length < NEED) {
          var page3 = Math.floor(Math.random() * TOTAL_PAGES) + 1;
          return fetchPage(page3).then(function(extra) {
            return shuffle(products.concat(extra));
          });
        }
        return products;
      })
      .then(function(products) {
        if (!products.length) {
          list.innerHTML = '';
          return;
        }
        var html = '';
        products.slice(0, NEED).forEach(function(p) {
          html += buildCard(p);
        });
        list.innerHTML = html;

        // Re-trigger the collection/wishlist app buttons
        document.dispatchEvent(new CustomEvent('rp:loaded'));
      })
      .catch(function(err) {
        console.warn('[random-products]', err);
        list.innerHTML = '';
      });
  }

  // Run only after page is fully idle — zero load impact
  if ('requestIdleCallback' in window) {
    requestIdleCallback(run, { timeout: 2000 });
  } else {
    setTimeout(run, 300);
  }
})();
</script>

<style>
  /* ── Skeleton ── */
  .rp-skel-img {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: linear-gradient(90deg,#f0f0f0 25%,#e4e4e4 50%,#f0f0f0 75%);
    background-size: 200% 100%;
    animation: rp-sh 1.4s infinite;
    border-radius: 4px;
  }
  .rp-skel-line {
    height: 13px;
    border-radius: 3px;
    background: linear-gradient(90deg,#f0f0f0 25%,#e4e4e4 50%,#f0f0f0 75%);
    background-size: 200% 100%;
    animation: rp-sh 1.4s infinite;
  }
  .rp-skel-btns {
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }
  .rp-skel-btn {
    flex: 1;
    height: 28px;
    border-radius: 3px;
    background: linear-gradient(90deg,#f0f0f0 25%,#e4e4e4 50%,#f0f0f0 75%);
    background-size: 200% 100%;
    animation: rp-sh 1.4s infinite;
  }
  @keyframes rp-sh {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

{% schema %}
{
  "name": "Random Products",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Random items from our catalog!!",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Number of products to display"
    }
  ],
  "presets": [{ "name": "Random Products" }]
}
{% endschema %}