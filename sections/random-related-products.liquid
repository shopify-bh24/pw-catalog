<section class="random-products-section page-width">
  <h2 class="product-recommendations__heading title">{{ section.settings.heading | escape }}</h2>
  <ul id="random-products-list" class="grid grid--2-col grid--4-col-desktop" role="list">
    </ul>
</section>

<script>
document.addEventListener("DOMContentLoaded", async function() {
  const container = document.getElementById("random-products-list");
  const limit = {{ section.settings.products_to_show | default: 8 }};

  try {
    const response = await fetch('/products.json?limit=50');
    const data = await response.json();
    const products = data.products.sort(() => 0.5 - Math.random()).slice(0, limit);

    // Fetch the product card snippet for each product
    const cardsHTML = await Promise.all(products.map(async (product) => {
      const res = await fetch(`/products/${product.handle}?view=card`);
      const text = await res.text();
      // Extract the card element (this assumes your card is wrapped in a specific class)
      const parser = new DOMParser();
      const doc = parser.parseFromString(text, 'text/html');
      return doc.querySelector('.grid__item').innerHTML; 
    }));

    container.innerHTML = cardsHTML.map(html => `<li class="grid__item">${html}</li>`).join('');
  } catch (err) {
    console.error("Error loading products:", err);
  }
});
</script>

{% schema %}
{
  "name": "Random Products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "default": "Random items from our 70K catalog!!", "label": "Heading" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "default": 8, "label": "Number to display" }
  ],
  "presets": [{ "name": "Random Products" }]
}
{% endschema %}