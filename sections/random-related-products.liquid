<section class="random-products-section page-width">
  <h2 class="title">{{ section.settings.heading | escape }}</h2>
  <ul id="random-products-list" class="grid grid--2-col grid--4-col-desktop" role="list">
    </ul>
</section>

<script>
document.addEventListener("DOMContentLoaded", async function() {
  const container = document.getElementById("random-products-list");
  const limit = {{ section.settings.products_to_show | default: 8 }};
  
  try {
    // Fetch products from the first page (up to 50 products)
    const response = await fetch('/products.json?limit=50');
    const data = await response.json();
    const products = data.products;

    // Shuffle and pick 8
    const shuffled = products.sort(() => 0.5 - Math.random());
    const selected = shuffled.slice(0, limit);

    // Build the HTML cards
    container.innerHTML = selected.map(product => `
      <li class="grid__item">
        <div class="product-card">
          <a href="/products/${product.handle}">
            <img src="${product.images[0]?.src || ''}" alt="${product.title}" style="width:100%">
            <h3>${product.title}</h3>
            <p>${product.variants[0].price} ${Shopify.currency.active}</p>
          </a>
        </div>
      </li>
    `).join('');
  } catch (err) {
    console.error("Error loading random products:", err);
  }
});
</script>

{% schema %}
{
  "name": "Random Products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Check these out!",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Number of products"
    }
  ],
  "presets": [{ "name": "Random Products" }]
}
{% endschema %}