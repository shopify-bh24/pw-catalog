{% comment %} random-related-products.liquid {% endcomment %}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'section-product-recommendations.css' | asset_url | stylesheet_tag }}

<section class="random related-products page-width spaced-section">
  <h2 class="product-recommendations__heading title">
    {{ section.settings.heading | escape }}
  </h2>
  <ul id="rp-list" class="grid grid--2-col product-grid grid--4-col-desktop" role="list"></ul>
</section>

<style>
  /* Skeleton shimmer */
  .rp-skel {
    background: linear-gradient(90deg,#f0f0f0 25%,#e8e8e8 50%,#f0f0f0 75%);
    background-size: 200% 100%;
    animation: rp-sh 1.4s infinite;
    border-radius: 4px;
    display: block;
  }
  @keyframes rp-sh {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* Match exact card structure from your theme */
  #rp-list .card-wrapper {
    position: relative;
  }
  #rp-list .card--product {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  #rp-list .card--product img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }
  #rp-list .rp-img-skel {
    width: 100%;
    aspect-ratio: 3 / 4;
  }
  #rp-list .card-information {
    padding: 8px 0;
  }
  #rp-list .card-information__wrapper {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #rp-list .card-information__text {
    font-size: 0.8rem;
    font-weight: 400;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }
  #rp-list .product-btn {
    display: flex;
    gap: 4px;
  }
  #rp-list .collection-btn,
  #rp-list .wishlist-btn {
    flex: 1;
    font-size: 0.7rem;
    font-weight: 500;
    text-align: center;
    padding: 5px 4px;
    border: 1px solid #333;
    border-radius: 3px;
    background: #fff;
    color: #333;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #rp-list .collection-btn:hover,
  #rp-list .wishlist-btn:hover {
    background: #333;
    color: #fff;
  }
  @media (max-width: 749px) {
    #rp-list .product-btn { flex-direction: column; }
  }
</style>

<script>
(function () {
  var STORE = 'https://pwcatalog.com';
  var NEED  = {{ section.settings.products_to_show | default: 8 }};
  var list  = document.getElementById('rp-list');
  if (!list) return;

  // ── Skeleton ──────────────────────────────────────────────────
  var skelHtml = '';
  for (var s = 0; s < NEED; s++) {
    skelHtml +=
      '<li class="grid__item p-card-hide">' +
        '<div class="card-wrapper">' +
          '<span class="rp-skel rp-img-skel"></span>' +
          '<div class="card-information">' +
            '<div class="card-information__wrapper">' +
              '<span class="rp-skel" style="height:13px;margin-bottom:4px"></span>' +
              '<span class="rp-skel" style="height:13px;width:65%"></span>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</li>';
  }
  list.innerHTML = skelHtml;

  // ── Helpers ───────────────────────────────────────────────────
  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
    }
    return arr;
  }

  function buildCard(p) {
    var img = p.images && p.images.length
      ? p.images[0].src.replace(/(\.[^.?]+)(\?.*)?$/, '_400x$1')
      : '';
    var url = '/products/' + p.handle;
    var id  = p.id;

    return '<li class="grid__item p-card-hide">' +
      '<div class="card-wrapper">' +
        '<a href="' + url + '" class="card card--product card--outline">' +
          (img
            ? '<img src="' + img + '" alt="' + p.title.replace(/"/g,'&quot;') + '" loading="lazy" width="400" height="533">'
            : '<span class="rp-skel rp-img-skel"></span>') +
        '</a>' +
        '<div class="card-information">' +
          '<div class="card-information__wrapper">' +
            '<h3 class="card-information__text h5">' + p.title + '</h3>' +
            '<span class="caption-large light"></span>' +
            '<div class="product-btn">' +
              '<a href="/account/login"' +
                ' class="collection-btn"' +
                ' data-product-id="' + id + '"' +
                ' data-product-price="0"' +
                ' data-action="add_to_collection"' +
                ' data-collection-id="">' +
                'Add to Collection' +
              '</a>' +
              '<a href="/account/login"' +
                ' class="wishlist-btn"' +
                ' data-product-id="' + id + '"' +
                ' data-product-price="0"' +
                ' data-action="add_to_wishlist"' +
                ' data-collection-id="">' +
                'Add to Wishlist' +
              '</a>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>' +
    '</li>';
  }

  // ── Data fetching ─────────────────────────────────────────────
  var collectionPool = [];
  var usedHandles    = {};
  var results        = [];

  function fetchCollectionPage(page) {
    return fetch(STORE + '/collections.json?limit=250&page=' + page)
      .then(function(r) { return r.json(); })
      .then(function(d) { return d.collections || []; })
      .catch(function() { return []; });
  }

  function fetchProductFromCollection(handle) {
    var page = Math.floor(Math.random() * 3) + 1;
    return fetch(STORE + '/collections/' + handle + '/products.json?limit=20&page=' + page)
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var prods = d.products || [];
        if (!prods.length && page > 1) {
          return fetch(STORE + '/collections/' + handle + '/products.json?limit=20&page=1')
            .then(function(r2) { return r2.json(); })
            .then(function(d2) { return d2.products || []; });
        }
        return prods;
      })
      .then(function(prods) {
        if (!prods.length) return null;
        return prods[Math.floor(Math.random() * prods.length)];
      })
      .catch(function() { return null; });
  }

  function tryFill() {
    if (results.length >= NEED || !collectionPool.length) {
      render();
      return;
    }
    var idx = Math.floor(Math.random() * collectionPool.length);
    var col = collectionPool.splice(idx, 1)[0];
    if (usedHandles[col.handle]) { tryFill(); return; }
    usedHandles[col.handle] = true;

    fetchProductFromCollection(col.handle).then(function(p) {
      if (p) results.push(p);
      tryFill();
    });
  }

  function render() {
    if (!results.length) { list.innerHTML = ''; return; }
    shuffle(results);
    var html = '';
    results.slice(0, NEED).forEach(function(p) { html += buildCard(p); });
    list.innerHTML = html;

    // Re-trigger any app scripts watching for new product cards
    document.dispatchEvent(new CustomEvent('rp:loaded', { detail: { products: results } }));
  }

  function run() {
    var p1 = Math.floor(Math.random() * 4) + 1;
    var p2 = p1 === 1 ? 2 : 1;
    Promise.all([fetchCollectionPage(p1), fetchCollectionPage(p2)])
      .then(function(pages) {
        var all = pages[0].concat(pages[1]).filter(function(c) {
          return c.handle !== 'all'
            && c.handle !== 'frontpage'
            && c.products_count > 0;
        });
        collectionPool = shuffle(all);
        tryFill();
      });
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(run);
  } else {
    setTimeout(run, 100);
  }
})();
</script>

{% schema %}
{
  "name": "Random Products",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Random items from our catalog!!",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Number of products to display"
    }
  ],
  "presets": [{ "name": "Random Products" }]
}
{% endschema %}