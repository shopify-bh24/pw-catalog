{% comment %}
  random-home-products.liquid
  ─────────────────────────────────────────────────────────────────
  WHAT CHANGED vs the old version:
  1. No hardcoded collection list — iterates ALL store collections automatically.
  2. Server renders only 16 product-card snippets (not 65+).
     JS then reveals 8 random ones, keeping your native card style.
  3. Removed the extra wrapper divs that were conflicting with the grid CSS.
{% endcomment %}

<section class="random related-products page-width spaced-section">
  <h2 class="product-recommendations__heading title">
    {{ section.settings.heading | escape }}
  </h2>

  <ul
    id="random-products-list"
    class="grid grid--2-col product-grid grid--4-col-desktop"
    role="list">

    {% assign rp_count = 0 %}
    {% assign rp_limit = 16 %}

    {% for collection in collections %}
      {% if rp_count >= rp_limit %}{% break %}{% endif %}
      {% if collection.products_count > 0 %}

        {% comment %} Pseudo-random product pick per collection {% endcomment %}
        {% assign rp_index = forloop.index | modulo: collection.products_count %}
        {% assign rp_product = collection.products[rp_index] %}

        <li class="grid__item rp-hidden" data-sort="{{ forloop.index | times: 2654435761 | modulo: 65537 }}">
          {% render 'product-card',
            product_card_product: rp_product,
            media_size: section.settings.image_ratio,
            show_secondary_image: section.settings.show_secondary_image,
            add_image_padding: section.settings.add_image_padding,
            show_vendor: section.settings.show_vendor,
            show_image_outline: section.settings.show_image_outline,
            show_rating: section.settings.show_rating
          %}
        </li>

        {% assign rp_count = rp_count | plus: 1 %}
      {% endif %}
    {% endfor %}

  </ul>
</section>

<script>
(function () {
  var list  = document.getElementById('random-products-list');
  if (!list) return;

  var items = Array.from(list.querySelectorAll('.rp-hidden'));
  if (!items.length) return;

  // Fisher-Yates shuffle for true client-side randomness every page load
  for (var i = items.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var tmp = items[i]; items[i] = items[j]; items[j] = tmp;
  }

  var toShow = {{ section.settings.products_to_show | default: 8 }};

  items.forEach(function (item, idx) {
    if (idx < toShow) {
      item.classList.remove('rp-hidden');
    } else {
      // Remove from DOM entirely — no hidden nodes wasting memory
      item.parentNode.removeChild(item);
    }
  });
})();
</script>

<style>
  .rp-hidden { display: none !important; }
</style>

{% schema %}
{
  "name": "Random Products",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Random items from our catalog!!",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Number of products to display"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt",    "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait"       },
        { "value": "square",   "label": "Square"         }
      ],
      "default": "square",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image on hover"
    },
    {
      "type": "checkbox",
      "id": "add_image_padding",
      "default": false,
      "label": "Add image padding"
    },
    {
      "type": "checkbox",
      "id": "show_image_outline",
      "default": false,
      "label": "Show image outline"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating"
    }
  ],
  "presets": [
    { "name": "Random Products" }
  ]
}
{% endschema %}