{% comment %}
  Strategy: sample products from 5 different offset points spread across
  all your collections, giving us a pool of ~40 cards from varied parts
  of the catalog. JS then picks 8 random ones and removes the rest.
  This gives genuine variety across all 1200 collections while keeping
  native card design with correct buttons.
{% endcomment %}

{% assign rp_total   = collections.size %}
{% assign rp_step    = rp_total | divided_by: 5 %}
{% assign rp_pool    = 0 %}
{% assign rp_target  = 40 %}
{% assign rp_per_seg = 8 %}

<section class="random related-products page-width spaced-section">
  <h2 class="product-recommendations__heading title">
    {{ section.settings.heading | escape }}
  </h2>

  <ul
    id="rp-list"
    class="grid grid--2-col product-grid grid--4-col-desktop grid--quarter-max"
    role="list">

    {% comment %} Segment 1 — start of catalog {% endcomment %}
    {% assign rp_count = 0 %}
    {% for collection in collections limit: 50 offset: 0 %}
      {% if rp_count >= rp_per_seg %}{% break %}{% endif %}
      {% if collection.products_count > 0 %}
        {% assign rp_idx = forloop.index | modulo: collection.products_count %}
        {% assign rp_p = collection.products[rp_idx] %}
        <li class="grid__item rp-hidden">
          {% render 'product-card',
            product_card_product: rp_p,
            media_size: section.settings.image_ratio,
            show_secondary_image: section.settings.show_secondary_image,
            add_image_padding: section.settings.add_image_padding,
            show_vendor: section.settings.show_vendor,
            show_image_outline: section.settings.show_image_outline,
            show_rating: section.settings.show_rating
          %}
        </li>
        {% assign rp_count = rp_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% comment %} Segment 2 — ~20% into catalog {% endcomment %}
    {% assign rp_off2 = rp_step %}
    {% assign rp_count = 0 %}
    {% for collection in collections limit: 50 offset: rp_off2 %}
      {% if rp_count >= rp_per_seg %}{% break %}{% endif %}
      {% if collection.products_count > 0 %}
        {% assign rp_idx = forloop.index | plus: 3 | modulo: collection.products_count %}
        {% assign rp_p = collection.products[rp_idx] %}
        <li class="grid__item rp-hidden">
          {% render 'product-card',
            product_card_product: rp_p,
            media_size: section.settings.image_ratio,
            show_secondary_image: section.settings.show_secondary_image,
            add_image_padding: section.settings.add_image_padding,
            show_vendor: section.settings.show_vendor,
            show_image_outline: section.settings.show_image_outline,
            show_rating: section.settings.show_rating
          %}
        </li>
        {% assign rp_count = rp_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% comment %} Segment 3 — ~40% into catalog {% endcomment %}
    {% assign rp_off3 = rp_step | times: 2 %}
    {% assign rp_count = 0 %}
    {% for collection in collections limit: 50 offset: rp_off3 %}
      {% if rp_count >= rp_per_seg %}{% break %}{% endif %}
      {% if collection.products_count > 0 %}
        {% assign rp_idx = forloop.index | plus: 7 | modulo: collection.products_count %}
        {% assign rp_p = collection.products[rp_idx] %}
        <li class="grid__item rp-hidden">
          {% render 'product-card',
            product_card_product: rp_p,
            media_size: section.settings.image_ratio,
            show_secondary_image: section.settings.show_secondary_image,
            add_image_padding: section.settings.add_image_padding,
            show_vendor: section.settings.show_vendor,
            show_image_outline: section.settings.show_image_outline,
            show_rating: section.settings.show_rating
          %}
        </li>
        {% assign rp_count = rp_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% comment %} Segment 4 — ~60% into catalog {% endcomment %}
    {% assign rp_off4 = rp_step | times: 3 %}
    {% assign rp_count = 0 %}
    {% for collection in collections limit: 50 offset: rp_off4 %}
      {% if rp_count >= rp_per_seg %}{% break %}{% endif %}
      {% if collection.products_count > 0 %}
        {% assign rp_idx = forloop.index | plus: 11 | modulo: collection.products_count %}
        {% assign rp_p = collection.products[rp_idx] %}
        <li class="grid__item rp-hidden">
          {% render 'product-card',
            product_card_product: rp_p,
            media_size: section.settings.image_ratio,
            show_secondary_image: section.settings.show_secondary_image,
            add_image_padding: section.settings.add_image_padding,
            show_vendor: section.settings.show_vendor,
            show_image_outline: section.settings.show_image_outline,
            show_rating: section.settings.show_rating
          %}
        </li>
        {% assign rp_count = rp_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% comment %} Segment 5 — ~80% into catalog {% endcomment %}
    {% assign rp_off5 = rp_step | times: 4 %}
    {% assign rp_count = 0 %}
    {% for collection in collections limit: 50 offset: rp_off5 %}
      {% if rp_count >= rp_per_seg %}{% break %}{% endif %}
      {% if collection.products_count > 0 %}
        {% assign rp_idx = forloop.index | plus: 17 | modulo: collection.products_count %}
        {% assign rp_p = collection.products[rp_idx] %}
        <li class="grid__item rp-hidden">
          {% render 'product-card',
            product_card_product: rp_p,
            media_size: section.settings.image_ratio,
            show_secondary_image: section.settings.show_secondary_image,
            add_image_padding: section.settings.add_image_padding,
            show_vendor: section.settings.show_vendor,
            show_image_outline: section.settings.show_image_outline,
            show_rating: section.settings.show_rating
          %}
        </li>
        {% assign rp_count = rp_count | plus: 1 %}
      {% endif %}
    {% endfor %}

  </ul>
</section>

<script>
(function () {
  var list = document.getElementById('rp-list');
  if (!list) return;

  var items = Array.from(list.querySelectorAll('.rp-hidden'));
  if (!items.length) return;

  // Fisher-Yates shuffle
  for (var i = items.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var tmp = items[i]; items[i] = items[j]; items[j] = tmp;
  }

  var toShow = {{ section.settings.products_to_show | default: 8 }};

  items.forEach(function(item, idx) {
    if (idx < toShow) {
      item.classList.remove('rp-hidden');
    } else {
      item.parentNode.removeChild(item);
    }
  });
})();
</script>

<style>
  .rp-hidden { display: none !important; }
</style>

{% schema %}
{
  "name": "Random Products",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Random items from our catalog!!",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Number of products to display"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt",    "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait"       },
        { "value": "square",   "label": "Square"         }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image on hover"
    },
    {
      "type": "checkbox",
      "id": "add_image_padding",
      "default": false,
      "label": "Add image padding"
    },
    {
      "type": "checkbox",
      "id": "show_image_outline",
      "default": false,
      "label": "Show image outline"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating"
    }
  ],
  "presets": [{ "name": "Random Products" }]
}
{% endschema %}