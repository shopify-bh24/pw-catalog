<section class="page-width" style="max-width: 100% !important; padding: 0 50px; margin-top: -30px;"> 
   <nav aria-label="Home" class="breadcrumb">
    <a class="Breadcrumbs" href="{{ routes.root_url }}">Home</a> 
    
    {%- for collection in product.collections limit: 3 -%} 
      {%- assign collection_handle_downcased = collection.handle | downcase -%}
      {%- unless collection_handle_downcased == 'all' -%}
        {%- assign mapped_wrestler = shop.metaobjects.collection_mapping[collection.handle] -%}
        {%- if mapped_wrestler == blank -%}
          {%- assign mapped_wrestler = shop.metaobjects.collection_mappings[collection.handle] -%}
        {%- endif -%}
        {%- unless mapped_wrestler -%}
          <span aria-hidden="true"> / </span>
          <a class="Breadcrumbs" href="{{ collection.url }}">{{ collection.title }}</a>
        {%- endunless -%}
      {%- endunless -%}
    {%- endfor -%}
  </nav>
</section>
<section class="page-width">
<div class="product grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">

  <!-- ============================================================
       PRODUCT MEDIA — new gallery (main image + thumbnails below)
       ============================================================ -->
  <div class="grid__item product__media-wrapper">

    <style>
    /* Force the container to use full width */
.page-width {
  max-width: 100% !important;
}

/* Force the grid to stretch and divide into two equal columns */
.product.grid {
  display: grid !important;
  grid-template-columns: 1fr 1fr !important; 
  gap: 40px !important;
  width: 100% !important;
}

/* Ensure the image column uses the full space */
.product__media-wrapper {
  width: 100% !important;
}

/* Ensure the text info wrapper expands to fill the right side */
.product__info-wrapper {
  width: 100% !important;
  max-width: 100% !important;
  padding-left: 0 !important;
}

.product__info-container {
  width: 100% !important;
  max-width: 100% !important;
}

    /* =============================================
       PRODUCT GALLERY — main image + thumbnails
       ============================================= */
    .product-gallery {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
    }

    /* --- Main image --- */
   .product-gallery__main {
      position: relative;
      width: 100%;
      /* Remove max-height or set to auto to allow full image height */
      max-height: none; 
      overflow: hidden;
      border-radius: 4px;
      /* Change background to transparent or white to hide the grey */
      background: transparent; 
      cursor: zoom-in;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .product-gallery__main img {
      width: 100%;
      height: auto;
      /* Remove max-height constraint */
      max-height: none; 
      /* Use cover or initial to let the image fill the space */
      object-fit: initial; 
      display: block;
      transition: opacity 0.25s ease;
    }
    .product-gallery__main:hover img { opacity: 0.92; }

    /* Zoom hint icon */
    .product-gallery__zoom-hint {
      position: absolute;
      bottom: 12px;
      right: 12px;
      background: rgba(0,0,0,0.45);
      color: #fff;
      border-radius: 50%;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .product-gallery__main:hover .product-gallery__zoom-hint { opacity: 1; }
    .product-gallery__zoom-hint svg { width: 18px; height: 18px; }

    /* --- Thumbnail strip --- */
    .product-gallery__thumbs {
      display: flex !important;
      flex-direction: row;
      gap: 8px;
      overflow-x: auto;
      padding: 4px 0 8px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      min-height: 80px;
    }
    .product-gallery__thumbs::-webkit-scrollbar { height: 4px; }
    .product-gallery__thumbs::-webkit-scrollbar-thumb { background: #ccc; border-radius: 2px; }

    .product-gallery__thumb {
      flex: 0 0 72px !important;
      width: 72px !important;
      height: 72px !important;
      border-radius: 4px;
      overflow: hidden;
      cursor: pointer;
      border: 2px solid transparent;
      transition: border-color 0.2s ease, opacity 0.2s ease;
      scroll-snap-align: start;
      background: #f4f4f4;
    }
    .product-gallery__thumb img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover;
      display: block;
    }
    .product-gallery__thumb:hover { opacity: 0.8; }
    .product-gallery__thumb.is-active { border-color: #222; opacity: 1; }

    /* =============================================
       LIGHTBOX
       ============================================= */
    .pg-lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0,0,0,0.88);
      align-items: center;
      justify-content: center;
      animation: pgFadeIn 0.2s ease;
    }
    .pg-lightbox.is-open { display: flex; }

    @keyframes pgFadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    .pg-lightbox__inner {
      position: relative;
      max-width: 90vw;
      max-height: 90vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .pg-lightbox__img {
      max-width: 90vw;
      max-height: 90vh;
      object-fit: contain;
      border-radius: 4px;
      display: block;
      animation: pgSlideIn 0.22s ease;
      transition: opacity 0.1s ease;
    }
    @keyframes pgSlideIn {
      from { transform: scale(0.95); opacity: 0; }
      to   { transform: scale(1);    opacity: 1; }
    }

    .pg-lightbox__btn {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255,255,255,0.15);
      border: none;
      color: #fff;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
      z-index: 10000;
    }
    .pg-lightbox__btn:hover { background: rgba(255,255,255,0.3); }
    .pg-lightbox__btn--prev { left: 16px; }
    .pg-lightbox__btn--next { right: 16px; }
    .pg-lightbox__btn svg  { width: 22px; height: 22px; }

    .pg-lightbox__close {
      position: fixed;
      top: 16px;
      right: 16px;
      background: rgba(255,255,255,0.15);
      border: none;
      color: #fff;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
      z-index: 10000;
    }
    .pg-lightbox__close:hover { background: rgba(255,255,255,0.3); }
    .pg-lightbox__close svg { width: 20px; height: 20px; }

    .pg-lightbox__counter {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      color: rgba(255,255,255,0.7);
      font-size: 13px;
      letter-spacing: 0.05em;
      z-index: 10000;
    }

    @media screen and (max-width: 749px) {
      .product-gallery__thumb { flex: 0 0 60px; width: 60px; height: 60px; }
      .pg-lightbox__btn--prev { left: 6px; }
      .pg-lightbox__btn--next { right: 6px; }
    }
    </style>

    {%- assign featured_media = product.selected_or_first_available_variant.featured_media -%}

    <div class="product-gallery" id="productGallery-{{ section.id }}">

      <!-- MAIN IMAGE -->
      <div class="product-gallery__main" id="pgMain-{{ section.id }}">
        {%- if featured_media != null -%}
          <img
            id="pgMainImg-{{ section.id }}"
            src="{{ featured_media | img_url: '900x900', crop: 'center' }}"
            data-hires="{{ featured_media | img_url: '2000x2000' }}"
            alt="{{ featured_media.alt | escape | default: product.title }}"
            width="900" height="900" loading="eager"
          >
        {%- elsif product.featured_image != blank -%}
          <img
            id="pgMainImg-{{ section.id }}"
            src="{{ product.featured_image | img_url: '900x900', crop: 'center' }}"
            data-hires="{{ product.featured_image | img_url: '2000x2000' }}"
            alt="{{ product.featured_image.alt | escape | default: product.title }}"
            width="900" height="900" loading="eager"
          >
        {%- endif -%}

        <span class="product-gallery__zoom-hint" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            <line x1="11" y1="8" x2="11" y2="14"/>
            <line x1="8" y1="11" x2="14" y2="11"/>
          </svg>
        </span>
      </div>

      <!-- THUMBNAIL STRIP -->
      {%- if product.media.size > 1 -%}
      <div class="product-gallery__thumbs" id="pgThumbs-{{ section.id }}" role="list">

        {%- if featured_media != null -%}
          <div
            class="product-gallery__thumb is-active"
            role="listitem" tabindex="0"
            data-media-id="{{ featured_media.id }}"
            data-src="{{ featured_media | img_url: '900x900', crop: 'center' }}"
            data-hires="{{ featured_media | img_url: '2000x2000' }}"
            data-alt="{{ featured_media.alt | escape | default: product.title }}"
            aria-label="{{ featured_media.alt | escape | default: product.title }}"
          >
            <img src="{{ featured_media | img_url: '160x160', crop: 'center' }}" alt="" loading="lazy" width="160" height="160">
          </div>
        {%- endif -%}

        {%- for media in product.media -%}
          {%- unless media.id == featured_media.id -%}
            <div
              class="product-gallery__thumb"
              role="listitem" tabindex="0"
              data-media-id="{{ media.id }}"
              data-src="{{ media | img_url: '900x900', crop: 'center' }}"
              data-hires="{{ media | img_url: '2000x2000' }}"
              data-alt="{{ media.alt | escape | default: product.title }}"
              aria-label="{{ media.alt | escape | default: product.title }}"
            >
              <img src="{{ media | img_url: '160x160', crop: 'center' }}" alt="" loading="lazy" width="160" height="160">
            </div>
          {%- endunless -%}
        {%- endfor -%}

      </div>
      {%- endif -%}

    </div><!-- /product-gallery -->

    <!-- LIGHTBOX -->
    <div class="pg-lightbox" id="pgLightbox-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Product image viewer">
      <button class="pg-lightbox__close" id="pgClose-{{ section.id }}" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
      <button class="pg-lightbox__btn pg-lightbox__btn--prev" id="pgPrev-{{ section.id }}" aria-label="Previous image">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
      <div class="pg-lightbox__inner">
        <img class="pg-lightbox__img" id="pgLightboxImg-{{ section.id }}" src="" alt="">
      </div>
      <button class="pg-lightbox__btn pg-lightbox__btn--next" id="pgNext-{{ section.id }}" aria-label="Next image">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
      <span class="pg-lightbox__counter" id="pgCounter-{{ section.id }}"></span>
    </div>

    <script>
    (function() {
      var sectionId  = '{{ section.id }}';
      var gallery    = document.getElementById('productGallery-' + sectionId);
      var mainImg    = document.getElementById('pgMainImg-' + sectionId);
      var mainWrap   = document.getElementById('pgMain-' + sectionId);
      var thumbsWrap = document.getElementById('pgThumbs-' + sectionId);
      var lightbox   = document.getElementById('pgLightbox-' + sectionId);
      var lbImg      = document.getElementById('pgLightboxImg-' + sectionId);
      var lbClose    = document.getElementById('pgClose-' + sectionId);
      var lbPrev     = document.getElementById('pgPrev-' + sectionId);
      var lbNext     = document.getElementById('pgNext-' + sectionId);
      var lbCounter  = document.getElementById('pgCounter-' + sectionId);

      if (!gallery || !mainImg) return;

      var mediaItems   = [];
      var currentIndex = 0;

      function buildMediaItems() {
        mediaItems = [];
        gallery.querySelectorAll('.product-gallery__thumb').forEach(function(t) {
          mediaItems.push({ src: t.dataset.src, hires: t.dataset.hires, alt: t.dataset.alt || '', el: t });
        });
      }
      buildMediaItems();

      function setActiveThumb(index) {
        gallery.querySelectorAll('.product-gallery__thumb').forEach(function(t) { t.classList.remove('is-active'); });
        var thumbs = gallery.querySelectorAll('.product-gallery__thumb');
        if (thumbs[index]) thumbs[index].classList.add('is-active');
        currentIndex = index;
      }

      function switchMain(index) {
        if (!mediaItems[index]) return;
        var item = mediaItems[index];
        mainImg.style.opacity = '0.4';
        setTimeout(function() {
          mainImg.src = item.src;
          mainImg.dataset.hires = item.hires;
          mainImg.alt = item.alt;
          mainImg.style.opacity = '1';
        }, 130);
        setActiveThumb(index);
      }

      if (thumbsWrap) {
        thumbsWrap.addEventListener('click', function(e) {
          var thumb = e.target.closest('.product-gallery__thumb');
          if (!thumb) return;
          var idx = Array.from(gallery.querySelectorAll('.product-gallery__thumb')).indexOf(thumb);
          if (idx > -1) switchMain(idx);
        });
        thumbsWrap.addEventListener('keydown', function(e) {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          var thumb = e.target.closest('.product-gallery__thumb');
          if (!thumb) return;
          var idx = Array.from(gallery.querySelectorAll('.product-gallery__thumb')).indexOf(thumb);
          if (idx > -1) switchMain(idx);
        });
      }

      function updateCounter() {
        if (lbCounter) lbCounter.textContent = (currentIndex + 1) + ' / ' + mediaItems.length;
      }

      function openLightbox(index) {
        if (!lightbox || !mediaItems[index]) return;
        currentIndex = index;
        lbImg.src = mediaItems[index].hires || mediaItems[index].src;
        lbImg.alt = mediaItems[index].alt;
        updateCounter();
        lightbox.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        if (lbClose) lbClose.focus();
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      function lbGoTo(index) {
        var total = mediaItems.length;
        currentIndex = (index + total) % total;
        lbImg.style.opacity = '0.3';
        setTimeout(function() {
          lbImg.src = mediaItems[currentIndex].hires || mediaItems[currentIndex].src;
          lbImg.alt = mediaItems[currentIndex].alt;
          lbImg.style.opacity = '1';
          updateCounter();
        }, 100);
        setActiveThumb(currentIndex);
      }

      if (mainWrap) mainWrap.addEventListener('click', function() { openLightbox(currentIndex); });
      if (lbClose)  lbClose.addEventListener('click', closeLightbox);
      if (lbPrev)   lbPrev.addEventListener('click', function() { lbGoTo(currentIndex - 1); });
      if (lbNext)   lbNext.addEventListener('click', function() { lbGoTo(currentIndex + 1); });

      if (lightbox) {
        lightbox.addEventListener('click', function(e) { if (e.target === lightbox) closeLightbox(); });
      }

      document.addEventListener('keydown', function(e) {
        if (!lightbox || !lightbox.classList.contains('is-open')) return;
        if (e.key === 'Escape')     closeLightbox();
        if (e.key === 'ArrowLeft')  lbGoTo(currentIndex - 1);
        if (e.key === 'ArrowRight') lbGoTo(currentIndex + 1);
      });

      var touchStartX = 0;
      if (lightbox) {
        lightbox.addEventListener('touchstart', function(e) { touchStartX = e.touches[0].clientX; }, { passive: true });
        lightbox.addEventListener('touchend',   function(e) {
          var diff = touchStartX - e.changedTouches[0].clientX;
          if (Math.abs(diff) > 50) { diff > 0 ? lbGoTo(currentIndex + 1) : lbGoTo(currentIndex - 1); }
        }, { passive: true });
      }

      document.addEventListener('variant:change', function(e) {
        var variant = e.detail && e.detail.variant;
        if (!variant || !variant.featured_media) return;
        var targetId = String(variant.featured_media.id);
        var idx = Array.from(gallery.querySelectorAll('.product-gallery__thumb'))
                       .findIndex(function(t) { return t.dataset.mediaId === targetId; });
        if (idx > -1) switchMain(idx);
      });

    })();
    </script>

    {%- if first_3d_model -%}
      <button
        class="button button--full-width product__xr-button"
        type="button"
        aria-label="{{ 'products.product.xr_button_label' | t }}"
        data-shopify-xr
        data-shopify-model3d-id="{{ first_3d_model.id }}"
        data-shopify-title="{{ product.title | escape }}"
        data-shopify-xr-hidden
      >
        {% render 'icon-3d-model' %}
        {{ 'products.product.xr_button' | t }}
      </button>
    {%- endif -%}

  </div>
  <!-- ============================================================
       END PRODUCT MEDIA
       ============================================================ -->

  <div class="product__info-wrapper grid__item">
