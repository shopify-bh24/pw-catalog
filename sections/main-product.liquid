        {%- when '@app' -%}
          {% render block %}
        {%- when 'text' -%}
        {%if getcounter == 0%}
        {%assign getcounter = 1%}
        {% if product.metafields.my_fields.promotion.value != blank %}
  <p class="product__text caption-with-letter-spacing" {{ block.shopify_attributes }}>
