{% if product and product.collections.size > 0 %}
  <div class="product-recommendations page-width isolate">
    {% for collection in product.collections %}
      {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
        
        {% if collection.products_count > 1 %}
          {% assign shown_count = 0 %}

          <div style="margin-top: 4rem; margin-bottom: 2rem;">
            
            <!-- Section Header -->
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem; border-bottom: 1px solid rgba(var(--color-foreground), 0.08); padding-bottom: 0.75rem;">
              <h2 class="product-recommendations__heading h2" style="margin: 0; text-transform: capitalize;">
                More items from {{ collection.title }}
              </h2>
              <a href="{{ collection.url }}" style="font-size: 1.3rem; color: rgb(18, 18, 18); text-decoration: underline; text-underline-offset: 0.3rem;">
                View all
              </a>
            </div>

            <!-- Forced Size 4-Column Grid Layout -->
            <ul class="grid product-grid grid--4-col-desktop grid--2-col-tablet-down" role="list" style="list-style: none; padding: 0; margin: 0;">
              {% for item in collection.products limit: 10 %}
                {% if item.id != product.id %}
                  
                  <li class="grid__item">
                    <div class="card-wrapper product-card-wrapper underline-links-hover">
                      <div class="card card--card card--media color-background-1 gradient">
                        
                        <!-- Forced Image Wrapper Layout to prevent disappearing photos -->
                        <div class="card__inner" style="width: 100%; display: block; position: relative;">
                          {% if item.featured_image %}
                            <div style="position: relative; width: 100%; aspect-ratio: 1 / 1; overflow: hidden; background: #ffffff; border: 1px solid rgba(var(--color-foreground), 0.04); border-radius: 4px;">
                              <a href="{{ item.url }}" style="display: block; width: 100%; height: 100%;">
                                {{ item.featured_image | image_url: width: 533 | image_tag: loading: 'lazy', class: 'motion-reduce', style: 'width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0;' }}
                              </a>
                            </div>
                          {% endif %}
                        </div>

                        <!-- Info Content Block (Price Removed) -->
                        <div class="card__content" style="padding-top: 1rem;">
                          <div class="card__information" style="padding: 0;">
                            <h3 class="card__heading h5" style="margin: 0; font-size: 1.3rem; line-height: 1.4;">
                              <a href="{{ item.url }}" class="full-unstyled-link" style="text-decoration: none; color: inherit;">
                                {{ item.title }}
                              </a>
                            </h3>
                            {% comment %} Price block has been completely deleted from here {% endcomment %}
                          </div>
                        </div>

                      </div>
                    </div>
                  </li>

                  {% assign shown_count = shown_count | plus: 1 %}
                  {% if shown_count == 4 %}
                    {% break %}
                  {% endif %}
                {% endif %}
              {% endfor %}
            </ul>

          </div>
        {% endif %}

      {% endunless %}
    {% endfor %}
  </div>
{% endif %}

{% schema %}
{
  "name": "More From Collection",
  "settings": [],
  "presets": [
    {
      "name": "More From Collection"
    }
  ]
}
{% endschema %}