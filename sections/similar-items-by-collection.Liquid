{% if product and product.collections.size > 0 %}
  <div class="product-recommendations page-width isolate">
    {% for collection in product.collections %}
      {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
        
        {% if collection.products_count > 1 %}
          <div style="margin-top: 4rem; margin-bottom: 2rem;">
            
            <div style="margin-bottom: 2rem; border-bottom: 1px solid rgba(var(--color-foreground), 0.08); padding-bottom: 0.75rem;">
              <h2 class="product-recommendations__heading h2" style="margin: 0; text-transform: capitalize; display: inline-block;">
                More items from {{ collection.title }} 
                <span style="font-size: 1.3rem; font-weight: normal; text-transform: none; margin-left: 0.5rem; letter-spacing: normal;">
                  (<a href="{{ collection.url }}" style="color: rgb(18, 18, 18); text-decoration: underline; text-underline-offset: 0.3rem;">view all</a>)
                </span>
              </h2>
            </div>

            <ul class="grid product-grid grid--4-col-desktop grid--2-col-tablet-down dynamic-shuffled-grid" role="list" style="list-style: none; padding: 0; margin: 0;">
              {% for item in collection.products limit: 25 %}
                {% if item.id != product.id %}
                  
                  <li class="grid__item shuffled-product-card" style="display: none;">
                    <div class="card-wrapper product-card-wrapper underline-links-hover">
                      <div class="card card--card card--media color-background-1 gradient">
                        
                        <div class="card__inner" style="width: 100%; display: block; position: relative;">
                          {% if item.featured_image %}
                            <div class="media media--transparent media--hover-effect global-hover-media-box" style="position: relative; width: 100%; aspect-ratio: 1 / 1; overflow: hidden; background: #ffffff; border: 1px solid rgba(var(--color-foreground), 0.04); border-radius: 4px;">
                              <a href="{{ item.url }}" style="display: block; width: 100%; height: 100%;">
                                <img src="{{ item.featured_image | image_url: width: 533 }}" loading="lazy" class="motion-reduce main-front-img" style="width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; transition: transform 0.3s ease, opacity 0.3s ease;" />
                                
                                {% if item.images.size > 1 %}
                                  <img src="{{ item.images[1] | image_url: width: 533 }}" loading="lazy" class="motion-reduce secondary-hover-img" style="width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; opacity: 0; transition: transform 0.3s ease, opacity 0.3s ease;" />
                                {% endif %}
                              </a>
                            </div>
                          {% endif %}
                        </div>

                        <div class="card__content" style="padding-top: 1rem;">
                          <div class="card__information" style="padding: 0;">
                            <h3 class="card__heading h5" style="margin: 0; font-size: 1.3rem; line-height: 1.4;">
                              <a href="{{ item.url }}" class="full-unstyled-link" style="text-decoration: none; color: inherit;">
                                {{ item.title }}
                              </a>
                            </h3>
                          </div>
                        </div>

                      </div>
                    </div>
                  </li>

                {% endif %}
              {% endfor %}
            </ul>

          </div>
        {% endif %}

      {% endunless %}
    {% endfor %}
  </div>

  <style>
    .shuffled-product-card:hover .secondary-hover-img {
      opacity: 1 !important;
    }
    .shuffled-product-card:hover .main-front-img {
      transform: scale(1.03);
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const grids = document.querySelectorAll('.dynamic-shuffled-grid');
      
      grids.forEach(grid => {
        let items = Array.from(grid.querySelectorAll('.shuffled-product-card'));
        if (items.length === 0) return;
        
        // Fisher-Yates shuffle algorithm
        for (let i = items.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [items[i], items[j]] = [items[j], items[i]];
        }
        
        // Slice exactly 4 elements
        const randomSelection = items.slice(0, 4);
        
        // Clear layout container
        grid.innerHTML = '';
        
        // Inject and show only our 4 random items
        randomSelection.forEach(item => {
          item.style.display = 'block';
          grid.appendChild(item);
        });
      });
    });
  </script>
{% endif %}