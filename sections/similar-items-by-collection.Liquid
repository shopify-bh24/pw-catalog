{% if product and product.collections.size > 0 %}
  <div class="product-recommendations page-width isolate">
    {% for collection in product.collections %}
      {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
        
        {% if collection.products_count > 1 %}

          <div style="margin-top: 4rem; margin-bottom: 2rem;">
            
            <!-- Section Header -->
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem; border-bottom: 1px solid rgba(var(--color-foreground), 0.08); padding-bottom: 0.75rem;">
              <h2 class="product-recommendations__heading h2" style="margin: 0; text-transform: capitalize;">
                More items from {{ collection.title }}
              </h2>
              <a href="{{ collection.url }}" style="font-size: 1.3rem; color: rgb(18, 18, 18); text-decoration: underline; text-underline-offset: 0.3rem;">
                View all
              </a>
            </div>

            <!-- Shuffling 4-Column Grid Layout (Pulls a pool of 24 items to randomize from) -->
            <ul class="grid product-grid grid--4-col-desktop grid--2-col-tablet-down dynamic-shuffled-grid" role="list" style="list-style: none; padding: 0; margin: 0;">
              {% assign random_pool_count = 0 %}
              {% for item in collection.products limit: 25 %}
                {% if item.id != product.id %}
                  
                  <!-- Set items to hidden initially so they don't flash, JS will reveal them -->
                  <li class="grid__item shuffled-product-card" style="display: none;">
                    <div class="card-wrapper product-card-wrapper underline-links-hover">
                      <div class="card card--card card--media color-background-1 gradient">
                        
                        <!-- Image Container -->
                        <div class="card__inner" style="width: 100%; display: block; position: relative;">
                          {% if item.featured_image %}
                            <div style="position: relative; width: 100%; aspect-ratio: 1 / 1; overflow: hidden; background: #ffffff; border: 1px solid rgba(var(--color-foreground), 0.04); border-radius: 4px;">
                              <a href="{{ item.url }}" style="display: block; width: 100%; height: 100%;">
                                {{ item.featured_image | image_url: width: 533 | image_tag: loading: 'lazy', class: 'motion-reduce', style: 'width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0;' }}
                              </a>
                            </div>
                          {% endif %}
                        </div>

                        <!-- Card Content (Title Only) -->
                        <div class="card__content" style="padding-top: 1rem;">
                          <div class="card__information" style="padding: 0;">
                            <h3 class="card__heading h5" style="margin: 0; font-size: 1.3rem; line-height: 1.4;">
                              <a href="{{ item.url }}" class="full-unstyled-link" style="text-decoration: none; color: inherit;">
                                {{ item.title }}
                              </a>
                            </h3>
                          </div>
                        </div>

                      </div>
                    </div>
                  </li>

                  {% assign random_pool_count = random_pool_count | plus: 1 %}
                {% endif %}
              {% endfor %}
            </ul>

          </div>
        {% endif %}

      {% endunless %}
    {% endfor %}
  </div>

  <!-- Client-Side Instant Shuffle Script -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const grids = document.querySelectorAll('.dynamic-shuffled-grid');
      
      grids.forEach(grid => {
        const items = Array.from(grid.querySelectorAll('.shuffled-product-card'));
        if (items.length === 0) return;

        // Fisher-Yates Shuffle Algorithm to mix up the layout pool
        for (let i = items.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [items[i], items[j]] = [items[j], items[i]];
        }

        // Wipe container clean and append the randomly sorted items back
        grid.innerHTML = '';
        items.forEach(item => grid.appendChild(item));

        // Display exactly the first 4 randomized items and turn them visible
        const finalSelection = grid.querySelectorAll('.shuffled-product-card');
        for (let k = 0; k < finalSelection.length; k++) {
          if (k < 4) {
            finalSelection[k].style.display = 'block';
          } else {
            finalSelection[k].remove(); // Trash excess items to keep page code light
          }
        }
      });
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "More From Collection",
  "settings": [],
  "presets": [
    {
      "name": "More From Collection"
    }
  ]
}
{% endschema %}