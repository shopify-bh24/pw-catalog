{% if product and product.collections.size > 0 %}
  <section class="similar-items-by-collection page-width">
    {% comment %} 
      Loop directly through the collections assigned to this specific product.
      This eliminates the 20-collection global platform limit entirely.
    {% endcomment %}
    {% for collection in product.collections %}
      {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
        
        {% comment %} Ensure the collection actually has other items to display {% endcomment %}
        {% if collection.products_count > 1 %}
          {% assign shown_count = 0 %}

          <div class="similar-items-by-collection__collection">
            <div class="similar-items-by-collection__collection-header">
              <h2 class="similar-items-by-collection__collection-title">
                More items from {{ collection.title }}
              </h2>
              <a class="similar-items-by-collection__view-all" href="{{ collection.url }}">
                View all
              </a>
            </div>

            <div class="similar-items-by-collection__grid">
              {% comment %} Retrieve products within this specific context collection {% endcomment %}
              {% for item in collection.products limit: 10 %}
                {% if item.id != product.id %}
                  <a class="similar-items-by-collection__card" href="{{ item.url }}">
                    {% if item.featured_image %}
                      <div class="similar-items-by-collection__image-wrapper">
                        {{ item.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'similar-items-by-collection__image' }}
                      </div>
                    {% endif %}

                    <div class="similar-items-by-collection__title">
                      {{ item.title }}
                    </div>
                  </a>

                  {% assign shown_count = shown_count | plus: 1 %}
                  {% if shown_count == 4 %}
                    {% break %}
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

      {% endunless %}
    {% endfor %}
  </section>
{% endif %}

{% schema %}
{
  "name": "More From Collection",
  "settings": [],
  "presets": [
    {
      "name": "More From Collection"
    }
  ]
}
{% endschema %}