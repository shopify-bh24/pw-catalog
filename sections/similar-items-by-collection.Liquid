{% if product and product.collections.size > 0 %}
  <div class="color-background-1 gradient" style="clear: both; display: block; width: 100%;">
    <section class="page-width" style="padding-top: 3rem; padding-bottom: 3rem; max-width: 1200px; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem;">
      {% for collection in product.collections %}
        {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
          
          {% if collection.products_count > 1 %}
            {% assign shown_count = 0 %}

            <div style="margin-bottom: 4rem; display: block; width: 100%;">
              
              <!-- Section Header -->
              <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem; border-bottom: 1px solid #f0f0f0; padding-bottom: 0.75rem;">
                <h2 style="margin: 0; font-size: 1.8rem; font-weight: 400; letter-spacing: 0.06rem; text-transform: capitalize; color: rgb(18, 18, 18);">
                  More items from {{ collection.title }}
                </h2>
                <a href="{{ collection.url }}" style="font-size: 1.3rem; color: rgb(18, 18, 18); text-decoration: underline; text-underline-offset: 0.3rem;">
                  View all
                </a>
              </div>

              <!-- Explicit CSS Variable Grid to Bypass Theme Conflicts -->
              <style>
                .custom-products-grid {
                  display: grid !important;
                  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
                  gap: 1.5rem !important;
                  list-style: none !important;
                  padding: 0 !important;
                  margin: 0 !important;
                  width: 100% !important;
                }
                .custom-grid-item-card {
                  text-decoration: none !important;
                  color: inherit !important;
                  display: flex !important;
                  flex-direction: column !important;
                }
                .custom-grid-img-wrap {
                  position: relative !important;
                  display: block !important;
                  aspect-ratio: 1 / 1 !important;
                  overflow: hidden !important;
                  background-color: rgba(18, 18, 18, 0.03) !important;
                  border-radius: 4px !important;
                  margin-bottom: 1rem !important;
                  width: 100% !important;
                }
                .custom-grid-img-wrap img {
                  width: 100% !important;
                  height: 100% !important;
                  object-fit: contain !important;
                  transition: transform 0.25s ease !important;
                }
                .custom-grid-item-card:hover .custom-grid-img-wrap img {
                  transform: scale(1.03) !important;
                }
                @media screen and (max-width: 749px) {
                  .custom-products-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
                    gap: 1rem !important;
                  }
                }
              </style>

              <!-- 4 Column Grid -->
              <ul class="custom-products-grid" role="list">
                {% for item in collection.products limit: 10 %}
                  {% if item.id != product.id %}
                    <li>
                      <a href="{{ item.url }}" class="custom-grid-item-card">
                        
                        {% if item.featured_image %}
                          <div class="custom-grid-img-wrap">
                            {{ item.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'motion-reduce' }}
                          </div>
                        {% endif %}

                        <div>
                          <h3 style="margin: 0 0 0.5rem 0; font-size: 1.3rem; font-weight: 400; line-height: 1.4; color: rgb(18, 18, 18); text-decoration: none;">
                            {{ item.title }}
                          </h3>
                          <div style="font-size: 1.4rem; color: rgb(18, 18, 18); font-weight: 400;">
                            {{ item.price | money }}
                          </div>
                        </div>

                      </a>
                    </li>

                    {% assign shown_count = shown_count | plus: 1 %}
                    {% if shown_count == 4 %}
                      {% break %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </ul>
              
            </div>
          {% endif %}

        {% endunless %}
      {% endfor %}
    </section>
  </div>
{% endif %}

{% schema %}
{
  "name": "More From Collection",
  "settings": [],
  "presets": [
    {
      "name": "More From Collection"
    }
  ]
}
{% endschema %}