{% if product and product.collections.size > 0 %}
  {% comment %}
    We inherit the exact product-recommendations class structure 
    so the cards match the layout of your upper row.
  {% endcomment %}
  <div class="product-recommendations page-width isolate">
    {% for collection in product.collections %}
      {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
        
        {% if collection.products_count > 1 %}
          {% assign shown_count = 0 %}

          <div style="margin-top: 4rem; margin-bottom: 2rem;">
            
            <!-- Unified Section Header Layout -->
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem; border-bottom: 1px solid rgba(var(--color-foreground), 0.08); padding-bottom: 0.75rem;">
              <h2 class="product-recommendations__heading h2" style="margin: 0; text-transform: capitalize;">
                More items from {{ collection.title }}
              </h2>
              <a href="{{ collection.url }}" style="font-size: 1.3rem; color: rgb(18, 18, 18); text-decoration: underline; text-underline-offset: 0.3rem;">
                View all
              </a>
            </div>

            <!-- Native 4-Column Grid Match -->
            <ul class="grid product-grid grid--4-col-desktop grid--2-col-tablet-down" role="list">
              {% for item in collection.products limit: 10 %}
                {% if item.id != product.id %}
                  
                  <li class="grid__item">
                    <div class="card-wrapper product-card-wrapper underline-links-hover">
                      <div class="card card--card card--media color-background-1 gradient" style="--ratio-percent: 100%;">
                        <div class="card__inner bbc-product-card-border" style="--ratio-percent: 100%;">
                          
                          <!-- Dynamic Image Logic -->
                          {% if item.featured_image %}
                            <div class="card__media">
                              <div class="media media--transparent media--hover-effect">
                                {{ item.featured_image | image_url: width: 533 | image_tag: loading: 'lazy', sizes: '(min-width: 1200px) 360px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)', class: 'motion-reduce' }}
                              </div>
                            </div>
                          {% endif %}

                        </div>

                        <!-- Info Content Block matches the upper rows exactly -->
                        <div class="card__content">
                          <div class="card__information">
                            <h3 class="card__heading h5">
                              <a href="{{ item.url }}" class="full-unstyled-link">
                                {{ item.title }}
                              </a>
                            </h3>
                            <div class="price">
                              <div class="price__container">
                                <div class="price-item price-item--regular">
                                  {{ item.price | money }}
                                From Collection</div>
                              </div>
                            </div>
                          </div>
                        </div>

                      </div>
                    </div>
                  </li>

                  {% assign shown_count = shown_count | plus: 1 %}
                  {% if shown_count == 4 %}
                    {% break %}
                  {% endif %}
                {% endif %}
              {% endfor %}
            </ul>

          </div>
        {% endif %}

      {% endunless %}
    {% endfor %}
  </div>
{% endif %}

{% schema %}
{
  "name": "More From Collection",
  "settings": [],
  "presets": [
    {
      "name": "More From Collection"
    }
  ]
}
{% endschema %}