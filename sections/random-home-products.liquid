{% comment %} 
  Fetch from Metaobject 
  Ensure 'collection_mapping' is the API Handle of your definition
  Ensure 'collection' is the API Handle of the field inside that definition
{% endcomment %}

{%- assign collection_handles = "" -%}
{%- for entry in shop.metaobjects.collection_mapping.values -%}
  {%- if entry.collection.value -%}
    {%- assign collection_handles = collection_handles | append: entry.collection.value.handle | append: "," -%}
  {%- endif -%}
{%- endfor -%}
{%- assign collection_handles = collection_handles | split: "," | uniq -%}

<section class="random related-products page-width">
  <h2 class="product-recommendations__heading title">Random wrestlers</h2>
  <div class="products-grid row owl-carousel">
    <ul id="random-products-list" class="grid grid--2-col product-grid grid--4-col-desktop grid--quarter-max" role="list">
      
      {% for handle in collection_handles %}
        {% assign collection = collections[handle] %}
        {% if collection and collection.products_count > 0 %}
          {% for product in collection.products limit: 1 %}
            <li class="grid__item hidden" data-collection="{{ handle }}" data-product-id="{{ product.id }}">
              {% render 'product-card',
                product_card_product: product,
                media_size: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                add_image_padding: section.settings.add_image_padding,
                show_vendor: section.settings.show_vendor,
                show_image_outline: section.settings.show_image_outline,
                show_rating: section.settings.show_rating
              %}
            </li>
          {% endfor %}
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const list = document.getElementById("random-products-list");
    const items = Array.from(list.querySelectorAll('.grid__item'));
    
    // Shuffle and pick 4
    items.sort(() => 0.5 - Math.random()).slice(0, 4).forEach(item => {
      item.classList.remove('hidden');
    });
  });
</script>

<style>
  .hidden { display: none !important; }
</style>