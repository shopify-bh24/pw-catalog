<section class="page-width random-collections-any">
  <h2 class="title">
    {{ section.settings.heading }} 
    <span style="font-size: 0.8em; opacity: 0.7;">({{ shop.metaobjects.collection_mapping.values.size }})</span>
  </h2>
  
  <div class="any-random-grid" id="random-collections-container">
    {% comment %} Dynamically setting the limit to the total number of entries {% endcomment %}
    {% paginate shop.metaobjects.collection_mapping.values by shop.metaobjects.collection_mapping.values.size %}
      {% for entry in shop.metaobjects.collection_mapping.values %}
        {% assign col_handle = entry.wrestler_collection.value | strip %}
        {% assign target = collections[col_handle] %}
        
        {% if target != blank %}
          <div class="rc-item-data" 
               data-url="{{ target.url }}" 
               data-img="{{ target.featured_image | image_url: width: 400 }}" 
               data-title="{{ target.title | escape }}" 
               data-count="{{ target.products_count }}"
               style="display:none;"></div>
        {% endif %}
      {% endfor %}
    {% endpaginate %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const container = document.getElementById('random-collections-container');
    const allData = Array.from(document.querySelectorAll('.rc-item-data'));
    
    if (allData.length === 0) return;

    // Fisher-Yates Shuffle
    for (let i = allData.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [allData[i], allData[j]] = [allData[j], allData[i]];
    }
    
    const selected = allData.slice(0, 8);
    
    let html = '';
    selected.forEach(item => {
      html += `
        <div class="rc-item">
          <a href="${item.dataset.url}">
            <img src="${item.dataset.img}" alt="${item.dataset.title}" loading="lazy">
            <h3>${item.dataset.title} (${item.dataset.count} items)</h3>
          </a>
        </div>
      `;
    });
    
    container.innerHTML = html;
  });
</script>