<section class="page-width random-collections-any">
  <h2 class="title">{{ section.settings.heading }}</h2>
  <div class="any-random-grid" id="random-collections-container" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;">
    {% for entry in shop.metaobjects.collection_mapping.values limit: 50 %}
      {% assign target = collections[entry.wrestler_collection.value] %}
      {% if target != blank %}
        <div class="rc-item-data" 
             data-url="{{ target.url }}" 
             data-img="{{ target.featured_image | image_url: width: 400 }}" 
             data-title="{{ target.title | escape }}" 
             data-count="{{ target.products_count }}"></div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<script>
  (function() {
    const container = document.getElementById('random-collections-container');
    const allData = Array.from(document.querySelectorAll('.rc-item-data'));
    if (allData.length === 0) return;
    
    // Shuffle and pick 8
    const selected = allData.sort(() => 0.5 - Math.random()).slice(0, 8);
    
    container.innerHTML = selected.map(item => `
      <div class="rc-item" style="text-align: center;">
        <a href="${item.dataset.url}">
          <img src="${item.dataset.img}" alt="${item.dataset.title}" loading="lazy" style="width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 8px;">
          <h3 style="font-size: 1.1rem; margin-top: 10px;">${item.dataset.title} (${item.dataset.count} items)</h3>
        </a>
      </div>
    `).join('');
  })();
</script>

{% schema %}
{
  "name": "Mapped Collections Random",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Random Wrestlers" } ],
  "presets": [{ "name": "Mapped Collections Random" }]
}
{% endschema %}