<section class="page-width" style="padding: 40px 0; border: 2px dashed red;">
  <h2>DIAGNOSTIC TOOL</h2>
  <p>Total Entries found in 'collection_mapping': {{ shop.metaobjects.collection_mapping.values.size }}</p>
  
  <ul style="max-height: 500px; overflow-y: scroll; background: #f9f9f9; padding: 20px;">
    {% for entry in shop.metaobjects.collection_mapping.values %}
      <li style="margin-bottom: 10px; border-bottom: 1px solid #ccc;">
        <strong>Entry:</strong> {{ entry.wrestler_name }}<br>
        <strong>Value of 'wrestler_collection':</strong> 
        {% if entry.wrestler_collection.value %}
          <span style="color: green;">FOUND: {{ entry.wrestler_collection.value.title }}</span>
        {% else %}
          <span style="color: red;">EMPTY / NOT FOUND</span>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>

{% schema %}
{
  "name": "Diagnostic Section",
  "presets": [{ "name": "Diagnostic Section" }]
}
{% endschema %}