<section class="page-width random-collections-any">
  <h2 class="title">{{ section.settings.heading }}</h2>
  
  <div class="any-random-grid">
    {% comment %} We loop through the Metaobjects first to enforce the whitelist condition {% endcomment %}
    {% assign valid_collections = "" | split: "," %}
    
    {% for entry in shop.metaobjects.collection_mapping.values %}
      {% assign target_col = entry.wrestler_collection.value %}
      
      {% if target_col %}
        {% assign valid_collections = valid_collections | push: target_col %}
      {% endif %}
    {% endfor %}
    
    {% comment %} Now we shuffle the valid, mapped collections and limit to 8 {% endcomment %}
    {% assign display_collections = valid_collections | shuffle %}
    
    {% for collection in display_collections limit: 8 %}
      <div class="rc-item">
        <a href="{{ collection.url }}">
          {% if collection.featured_image %}
            <img src="{{ collection.featured_image | image_url: width: 400 }}" 
                 alt="{{ collection.title | escape }}" 
                 loading="lazy">
          {% endif %}
          <h3>{{ collection.title }}</h3>
        </a>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .random-collections-any .any-random-grid { 
    display: grid !important; 
    grid-template-columns: repeat(4, 1fr) !important; 
    gap: 20px !important; 
    margin-top: 20px !important;
  }
  
  @media screen and (max-width: 749px) {
    .random-collections-any .any-random-grid { 
      grid-template-columns: repeat(2, 1fr) !important; 
    }
  }

  .random-collections-any .rc-item { 
    text-align: center; 
  }
  
  .random-collections-any .rc-item img { 
    width: 100% !important; 
    aspect-ratio: 1 / 1 !important; 
    object-fit: cover !important; 
    border-radius: 8px !important; 
    display: block !important;
  }
  
  .random-collections-any .rc-item h3 { 
    margin-top: 10px; 
    font-size: 1.1rem; 
  }
</style>

{% schema %}
{
  "name": "Mapped Collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Random Wrestlers" }
  ],
  "presets": [{ "name": "Mapped Collections" }]
}
{% endschema %}