<section class="page-width">
  <h2 class="title">{{ section.settings.heading }}</h2>
  
  <div id="random-collections-list" class="grid grid--2-col grid--4-col-desktop">
    {% for entry in shop.metaobjects.collection_mapping.values %}
      {% comment %} Retrieve the collection reference {% endcomment %}
      {% assign target_collection = entry.wrestler_collection.value %}
      
      {% if target_collection != blank %}
        <div class="grid__item collection-item hidden">
          <a href="{{ target_collection.url }}">
            {% if target_collection.featured_image %}
              {% comment %} Use image_url for the collection image {% endcomment %}
              <img src="{{ target_collection.featured_image | image_url: width: 400 }}" 
                   alt="{{ target_collection.title | escape }}" 
                   loading="lazy" 
                   width="400" 
                   height="auto">
            {% endif %}
            <h3>{{ target_collection.title }}</h3>
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const list = document.getElementById("random-collections-list");
    if (!list) return;
    
    // Select all items initially hidden
    const items = Array.from(list.querySelectorAll('.collection-item'));
    
    // Shuffle and pick 8
    // If there are fewer than 8, it will just show all of them
    items.sort(() => 0.5 - Math.random()).slice(0, 8).forEach(item => {
      item.classList.remove('hidden');
    });
  });
</script>

<style>
  .hidden { display: none !important; }
  .grid__item { text-align: center; }
  .grid__item img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; }
  .grid__item h3 { margin-top: 10px; font-size: 1.1rem; }
</style>

{% schema %}
{
  "name": "Random Collections HP",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wrestlers"
    }
  ],
  "presets": [
    {
      "name": "Random Collections HP"
    }
  ]
}
{% endschema %}