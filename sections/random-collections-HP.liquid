<section class="page-width random-collections-any">
  <h2 class="title">{{ section.settings.heading }}</h2>
  
  {%- assign all_entries = shop.metaobjects.collection_mapping.values -%}
  {%- assign total_entries = all_entries.size -%}
  
  <div class="any-random-grid" id="random-collections-container">
    {% comment %} 
      We pass the total count to JS if needed, 
      and output the JSON array for all available entries.
    {% endcomment %}
    <script type="application/json" id="random-collections-data">
      [
        {% for entry in all_entries %}
          {% assign col = entry.wrestler_collection.value %}
          {% if col != blank %}
            {
              "url": {{ col.url | json }},
              "img": {{ col.featured_image | image_url: width: 400 | json }},
              "title": {{ col.title | json }},
              "count": {{ col.products_count | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      ]
    </script>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const dataElement = document.getElementById('random-collections-data');
    if (!dataElement) return;
    
    const rawData = JSON.parse(dataElement.textContent);
    const container = document.getElementById('random-collections-container');
    
    if (rawData.length === 0) return;

    // Fisher-Yates Shuffle for true randomness
    const shuffled = [...rawData];
    for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    
    // Select up to 8 items
    const selected = shuffled.slice(0, 8);
    
    let html = '';
    selected.forEach(item => {
      html += `
        <div class="rc-item">
          <a href="${item.url}">
            <img src="${item.img}" alt="${item.title}" loading="lazy">
            <h3>${item.title} (${item.count} items)</h3>
          </a>
        </div>
      `;
    });
    container.innerHTML = html;
  });
</script>

<style>
  .random-collections-any .any-random-grid { display: grid !important; grid-template-columns: repeat(4, 1fr) !important; gap: 20px !important; margin-top: 20px !important; }
  @media screen and (max-width: 749px) { .random-collections-any .any-random-grid { grid-template-columns: repeat(2, 1fr) !important; } }
  .random-collections-any .rc-item { text-align: center; }
  .random-collections-any .rc-item img { width: 100% !important; aspect-ratio: 1 / 1 !important; object-fit: cover !important; border-radius: 8px !important; display: block !important; }
  .random-collections-any .rc-item h3 { margin-top: 10px; font-size: 1.1rem; }
</style>