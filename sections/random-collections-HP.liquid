<section class="page-width">
  <h2 class="title">{{ section.settings.heading }}</h2>
  
  <div style="border: 2px solid red; padding: 10px;">
    <h3>DEBUG INFO:</h3>
    <p>Total Metaobject entries: {{ shop.metaobjects.collection_mapping.values.size }}</p>
    
    {% for entry in shop.metaobjects.collection_mapping.values %}
      <p>Entry {{ forloop.index }}: {{ entry.system.handle }} | 
         Collection detected: {% if entry.collection.value %}YES{% else %}NO{% endif %}</p>
    {% endfor %}
  </div>

  <div id="random-collections-list" class="grid grid--2-col grid--4-col-desktop">
    {% for entry in shop.metaobjects.collection_mapping.values %}
      {% assign collection = entry.collection.value %}
      {% if collection %}
        <div class="grid__item collection-item">
          <a href="{{ collection.url }}">
            <h3>{{ collection.title }}</h3>
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>