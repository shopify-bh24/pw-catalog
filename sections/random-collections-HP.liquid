<section class="page-width">
  <h2 class="title">{{ section.settings.heading }}</h2>
  
  <div id="random-collections-list" class="grid grid--2-col grid--4-col-desktop">
    {% for entry in shop.metaobjects.collection_mapping.values %}
      {% comment %} We access the collection directly from the reference field {% endcomment %}
      {% assign target_collection = entry.wrestler_collection.value %}
      
      {% if target_collection %}
        <div class="grid__item collection-item hidden">
          <a href="{{ target_collection.url }}">
            {% comment %} Attempt to show image, falling back if empty {% endcomment %}
            <img src="{{ target_collection.featured_image | image_url: width: 400 }}" 
                 alt="{{ target_collection.title | escape }}" 
                 loading="lazy">
            <h3>{{ target_collection.title }}</h3>
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const list = document.getElementById("random-collections-list");
    if (!list) return;
    
    // Select all items initially hidden
    const items = Array.from(list.querySelectorAll('.collection-item'));
    
    // Shuffle and pick 8
    items.sort(() => 0.5 - Math.random()).slice(0, 8).forEach(item => {
      item.classList.remove('hidden');
    });
  });
</script>

<style>
  .hidden { display: none !important; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .grid__item img { width: 100%; height: 250px; object-fit: cover; }
</style>

{% schema %}
{
  "name": "Random Collections HP",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wrestlers"
    }
  ],
  "presets": [{ "name": "Random Collections HP" }]
}
{% endschema %}