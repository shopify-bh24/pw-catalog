          "settings": {
            "custom_liquid": "{%- comment %} 1. Load ALL metaobjects into a hidden list (bypassing the 250 limit) {% endcomment %}\n<div id=\"wrestler-data-container\" style=\"display:none;\">\n  {% paginate shop.metaobjects.collection_mapping.values by 1000 %}\n    {% for entry in shop.metaobjects.collection_mapping.values %}\n      <div class=\"wrestler-mapping\" \n           data-handle=\"{{ entry.wrestler_collection | strip }}\" \n           data-name=\"{{ entry.wrestler_name | escape }}\"\n           data-url=\"{{ shop.url }}/collections/{{ entry.wrestler_collection | strip }}\">\n      </div>\n    {% endfor %}\n  {% endpaginate %}\n</div>\n\n{%- comment %} 2. Output Product Collections data for the script {% endcomment %}\n{% for collection in product.collections %}\n  <div class=\"product-collection-reference\" \n       data-collection-handle=\"{{ collection.handle | strip }}\"\n       data-collection-title=\"{{ collection.title | escape }}\"\n       data-collection-url=\"{{ collection.url }}\">\n  </div>\n{% endfor %}\n\n{%- comment %} 3. This area will only show the matched results {% endcomment %}\n<div id=\"wrestler-result-display\" style=\"margin-top: 1rem;\"></div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    const mappings = document.querySelectorAll('.wrestler-mapping');\n    const productCollections = document.querySelectorAll('.product-collection-reference');\n    const display = document.getElementById('wrestler-result-display');\n    \n    let matchedHTML = [];\n\n    // Compare each product collection handle against the full mapping list\n    productCollections.forEach(col => {\n      const colHandle = col.dataset.collectionHandle;\n      const match = Array.from(mappings).find(m => m.dataset.handle === colHandle);\n      \n      if (match) {\n        // Only push to array if a match is found\n        matchedHTML.push(`<a href=\"${col.dataset.collectionUrl}\" style=\"margin-right: 10px;\">${match.dataset.name}</a>`);\n      }\n    });\n\n    // If we have matches, display them\n    if (matchedHTML.length > 0) {\n      display.innerHTML = '<p><strong>Wrestlers Featured:</strong> ' + matchedHTML.join(',') + '</p>';\n    }\n  });\n</script>"
          }
