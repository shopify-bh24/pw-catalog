        "custom_liquid_49Gtb9": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div style=\"border: 3px solid #000; padding: 20px; margin: 20px 0; background: #fdfdfd; font-family: monospace;\">\n  <h3>Debug: Product Collection vs. Full Metaobject List</h3>\n\n  {%- comment %} 1. Load full metaobject list into memory {% endcomment %}\n  <div id=\"metaobject-inventory\" style=\"display:none;\">\n    {% paginate shop.metaobjects.collection_mapping.values by 1000 %}\n      {% for entry in shop.metaobjects.collection_mapping.values %}\n        <div class=\"meta-entry\" \n             data-handle=\"{{ entry.wrestler_collection | strip }}\" \n             data-name=\"{{ entry.wrestler_name | escape }}\">\n        </div>\n      {% endfor %}\n    {% endpaginate %}\n  </div>\n\n  <ul style=\"list-style: none; padding: 0;\">\n    {% for collection in product.collections %}\n      {% assign col_handle = collection.handle | strip %}\n      <li style=\"border-bottom: 1px solid #ccc; padding: 10px 0;\">\n        <strong>Collection Title:</strong> {{ collection.title }}<br>\n        <strong>URL:</strong> <code>{{ collection.url }}</code><br>\n        <strong>Handle for search:</strong> <code>{{ col_handle }}</code><br>\n        <strong>Status:</strong> <span class=\"match-status\" data-check=\"{{ col_handle }}\">Checking...</span>\n      </li>\n    {% endfor %}\n  </ul>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    const metaEntries = document.querySelectorAll('.meta-entry');\n    const statusElements = document.querySelectorAll('.match-status');\n    \n    statusElements.forEach(el => {\n      const handleToCheck = el.dataset.check;\n      // Search memory for a matching handle\n      const found = Array.from(metaEntries).find(m => m.dataset.handle === handleToCheck);\n      \n      if (found) {\n        el.innerHTML = '<span style=\"color: green; font-weight: bold;\">[FOUND IN METAOBJECT: ' + found.dataset.name + ']</span>';\n      } else {\n        el.innerHTML = '<span style=\"color: red; font-weight: bold;\">[NOT FOUND]</span>';\n      }\n    });\n  });\n</script>"
          }
        },
